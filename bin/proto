    p_init_proj = sub.add_parser("init-project", help="Khởi tạo DESIGN-CONTEXT.md và README.md trong dự án")
    p_init_proj.add_argument("project_path", help="Đường dẫn tới dự án (vd: ../my-project)")
    p_init_proj.add_argument("--slug", help="Slug dự án")
    p_init_proj.add_argument("--domain", help="Mã lĩnh vực mặc định (vd: 04-creative-editor)")
    p_init_proj.add_argument("--force", action="store_true", help="Ghi đè DESIGN-CONTEXT.md nếu đã có")
    p_init_proj.add_argument("--field", help="Mô tả 1 dòng lĩnh vực của dự án (ghi vào README kho mockup), vd: 'bán lẻ & dịch vụ nhãn khoa'")
    p_init_proj.add_argument("--ref", action="append", help="Dự án trước đây dùng làm nguồn tham khảo (lặp cờ được); chỉ ghi tên, không chép tri thức")
    p_init_proj.set_defaults(func=cmd_init_project)

    p_set = sub.add_parser("set-phase", help="Gắn phase/stage cho phiên bản đã có (chỉ sửa meta, không đụng nội dung)")
