    p_lint = sub.add_parser("lint-knowledge", help="Kiểm tra trùng lặp, ID, định dạng cũ, quy tắc rò rỉ tên dự án")
    p_lint.set_defaults(func=cmd_lint_knowledge)

    p_pub = sub.add_parser("publish", help="Build manifest, commit và đẩy lên GitHub Pages")
