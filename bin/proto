    p_fx = sub.add_parser("fixed", help="Fixer khai kết quả sau khi sửa (đã sửa/bỏ finding nào) → ghi REVISIONS.md; không chạy review")
    p_fx.add_argument("project")
    p_fx.add_argument("feature")
    p_fx.add_argument("version")
    p_fx.add_argument("--done", default="", help="ID đã sửa, cách nhau dấu phẩy")
    p_fx.add_argument("--skip", default="", help="ID không sửa được (đụng cấu trúc / chờ chuyên gia…)")
    p_fx.add_argument("--why", help="Lý do bỏ (bắt buộc khi có --skip)")
    p_fx.add_argument("--agent", help="Tên agent đã sửa")
    p_fx.set_defaults(func=cmd_fixed)

    p_nx = sub.add_parser("next", help="Chỉ đọc: version đang ở đâu + các bước kế tiếp (vai, lệnh) để người chọn giao cho agent nào")
    p_nx.add_argument("project")
    p_nx.add_argument("feature")
    p_nx.add_argument("version")
    p_nx.add_argument("--project-path", help="Thư mục dự án (worktree) nếu không nằm cạnh kho mockup")
    p_nx.set_defaults(func=cmd_next)

    p_sl = sub.add_parser(
        "seal",
        help="Cổng của người: khóa version (bất biến) trước khi gửi link cho người trong dự án; BLOCKER/MAJOR chỉ qua được khi người --accept/--assume + lý do",
    )
    p_sl.add_argument("project")
    p_sl.add_argument("feature")
    p_sl.add_argument("version")
    p_sl.add_argument("--by", required=True, help="Người cho qua (vai trò/bí danh; sẽ được publish)")
    p_sl.add_argument("--accept", help="ID BLOCKER/MAJOR chấp nhận có chủ đích, cách nhau dấu phẩy")
    p_sl.add_argument("--assume", help="ID BLOCKER/MAJOR cần chuyên gia nhưng chọn mặc định theo khuyến nghị để đi tiếp (Sổ giả định)")
    p_sl.add_argument("--reason", help="Lý do cho qua (bắt buộc khi có --accept/--assume)")
    p_sl.add_argument("--project-path", help="Thư mục dự án (worktree) nếu không nằm cạnh kho mockup")
    p_sl.set_defaults(func=cmd_seal)

    p_gd = sub.add_parser(
        "guide",
        help="Guide demo TÙY CHỌN cho một version (lớp additive ngoài thư mục version): init = dựng khung, stamp = đóng dấu, check = soát lỗi thời (không chặn)",
    )
    p_gd.add_argument("action", choices=["init", "stamp", "check"])
    p_gd.add_argument("project")
    p_gd.add_argument("feature")
    p_gd.add_argument("version")
    p_gd.add_argument("--title", help="Tiêu đề guide (init)")
    p_gd.add_argument("--strict", action="store_true", help="check: thoát mã 1 nếu có cảnh báo (mặc định chỉ báo, không chặn)")
    p_gd.set_defaults(func=cmd_guide)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
