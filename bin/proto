#!/usr/bin/env python3
"""
proto — CLI quản lý vòng đời Mockup & Prototype tập trung
Vị trí: <kho mockup>/bin/proto (gọi qua ~/.config/mockup/root/bin/proto)
"""

from __future__ import annotations

import argparse
import datetime
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent.parent
PROTOTYPES_DIR = ROOT_DIR / "prototypes"
TEMPLATES_DIR = ROOT_DIR / "templates"
KNOWLEDGE_DIR = ROOT_DIR / "knowledge"
MANIFEST_FILE = ROOT_DIR / "prototypes.json"


def now_iso() -> str:
    return datetime.datetime.now(datetime.timezone.utc).astimezone().isoformat(timespec="seconds")


def today_str() -> str:
    return datetime.datetime.now().strftime("%Y-%m-%d")


def run_cmd(cmd: list[str], cwd: Path = ROOT_DIR, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, cwd=str(cwd), text=True, capture_output=True, check=check)


def get_pages_base_url() -> str:
    """Lấy URL GitHub Pages từ git remote origin nếu có."""
    try:
        res = run_cmd(["git", "remote", "get-url", "origin"], check=False)
        url = res.stdout.strip()
        if not url:
            return ""
        # Hỗ trợ cả HTTPS và SSH: git@github.com:user/repo.git hoặc https://github.com/user/repo.git
        if "github.com" in url:
            part = url.split("github.com")[-1].lstrip(":/").removesuffix(".git")
            pieces = part.split("/")
            if len(pieces) >= 2:
                owner, repo = pieces[0], pieces[1]
                return f"https://{owner}.github.io/{repo}"
    except Exception:
        pass
    return ""


def phase_sort_key(phase: str) -> tuple:
    """P00 < P00A < P01 < … < P10 < F01 (fix)."""
    m = re.match(r"^([A-Z]+)(\d+)([A-Z]*)$", phase or "")
    if not m:
        return ("~", 0, phase)
    return (m.group(1), int(m.group(2)), m.group(3))


def normalize_phase(raw: str | None) -> str:
    if not raw:
        return ""
    ph = raw.strip().upper()
    if not re.match(r"^[A-Z]+\d+[A-Z]*$", ph):
        fail(f"Mã phase không hợp lệ: '{raw}'. Dạng hợp lệ: P00, P00A, P03, F01…")
    return ph


def warn_unknown_phase(proj_slug: str, phase: str) -> None:
    """Cảnh báo (không chặn) nếu dự án có docs/03-phases mà không thấy thư mục phase tương ứng."""
    phases_dir = ROOT_DIR.parent / proj_slug / "docs" / "03-phases"
    if phase and phases_dir.is_dir():
        names = [d.name for d in phases_dir.iterdir() if d.is_dir()]
        if not any(n == phase or n.startswith(phase + "-") for n in names):
            print(f"[CẢNH BÁO] Không thấy {phases_dir}/{phase}-* — kiểm tra lại mã phase.", file=sys.stderr)


def build_manifest_data() -> dict:
    PROTOTYPES_DIR.mkdir(parents=True, exist_ok=True)
    projects_list = []

    for proj_dir in sorted(PROTOTYPES_DIR.iterdir()):
        if not proj_dir.is_dir() or proj_dir.name.startswith("."):
            continue

        features_list = []
        for feat_dir in sorted(proj_dir.iterdir()):
            if not feat_dir.is_dir() or feat_dir.name.startswith("."):
                continue

            meta_path = feat_dir / "meta.json"
            meta = {}
            if meta_path.is_file():
                try:
                    meta = json.loads(meta_path.read_text(encoding="utf-8"))
                except Exception:
                    meta = {}

            # Quét các thư mục phiên bản thực tế trên đĩa
            recorded_versions = {v.get("version"): v for v in meta.get("versions", []) if isinstance(v, dict)}
            versions = []
            for ver_dir in sorted(feat_dir.iterdir()):
                if not ver_dir.is_dir() or ver_dir.name.startswith("."):
                    continue
                if not (ver_dir / "index.html").is_file():
                    continue
                v_slug = ver_dir.name
                v_info = recorded_versions.get(v_slug, {})
                versions.append({
                    "version": v_slug,
                    "created_at": v_info.get("created_at", ""),
                    "phase": v_info.get("phase", ""),
                    "stage": v_info.get("stage", ""),
                    "notes": v_info.get("notes", ""),
                    # Trạng thái công khai cho Hub: bản hiệu chỉnh, đã khóa chưa, tóm tắt review (không chứa nội dung finding)
                    "rev": version_rev(v_info),
                    "sealed": bool(v_info.get("sealed")),
                    "review": review_summary(proj_dir.name, feat_dir.name, v_slug, v_info),
                })

            if not versions and not meta:
                continue

            feat_entry = {
                "slug": feat_dir.name,
                "title": meta.get("title", feat_dir.name),
                "domain": meta.get("domain", ""),
                "persona": meta.get("persona", ""),
                "approved_version": meta.get("approved_version", ""),
                "promoted_to": meta.get("promoted_to", ""),
                "phases": sorted({v["phase"] for v in versions if v["phase"]}, key=phase_sort_key),
                "versions": versions,
            }
            features_list.append(feat_entry)

        if features_list:
            projects_list.append({
                "slug": proj_dir.name,
                "phases": sorted({ph for f in features_list for ph in f["phases"]}, key=phase_sort_key),
                "features": features_list,
            })

    return {
        "updated_at": now_iso(),
        "projects": projects_list,
    }


def build_manifest() -> dict:
    manifest = build_manifest_data()
    MANIFEST_FILE.write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return manifest


def cmd_build(_args: argparse.Namespace) -> None:
    manifest = build_manifest()
    proj_count = len(manifest["projects"])
    feat_count = sum(len(p["features"]) for p in manifest["projects"])
    print(f"[OK] Đã cập nhật {MANIFEST_FILE.name}: {proj_count} dự án, {feat_count} màn hình.")


def cmd_new(args: argparse.Namespace) -> None:
    proj_slug = args.project.strip()
    feat_slug = args.feature.strip()
    ver_slug = args.version.strip()

    feat_dir = PROTOTYPES_DIR / proj_slug / feat_slug
    ver_dir = feat_dir / ver_slug

    if ver_dir.exists() and not args.force:
        print(
            f"[CHẶN GHI ĐÈ] Phiên bản '{proj_slug}/{feat_slug}/{ver_slug}' đã tồn tại!\n"
            f"Theo quy tắc Immutable Iterations (Không ghi đè lịch sử), hãy tạo phiên bản mới "
            f"(ví dụ: v2, v3, v2-refined) để giữ lại bản cũ phục vụ so sánh.\n"
            f"Ngoại lệ: nếu version đó CHƯA khóa (chưa `proto seal`, chưa tới tay người) và bạn chỉ sửa theo finding của review "
            f"→ dùng `proto revise {proj_slug} {feat_slug} {ver_slug} --fixes …` (skill/REVIEW.md §9), không tạo version mới.",
            file=sys.stderr,
        )
        sys.exit(1)

    prev_meta_path = feat_dir / "meta.json"
    if prev_meta_path.is_file():
        try:
            prev_names = [v.get("version") for v in json.loads(prev_meta_path.read_text(encoding="utf-8")).get("versions", [])]
            prev_ver = next((n for n in reversed(prev_names) if n and n != ver_slug), "")
        except Exception:
            prev_ver = ""
        if prev_ver:
            if brief_path_for(proj_slug, feat_slug, prev_ver).is_file():
                print(f"[INFO] Đọc brief bản trước trước khi design: {brief_path_for(proj_slug, feat_slug, prev_ver)}")
            elif latest_report(reviews_dir_for(proj_slug, feat_slug, prev_ver), "core") or \
                    latest_report(reviews_dir_for(proj_slug, feat_slug, prev_ver), "business"):
                print(f"[CẢNH BÁO] {prev_ver} đã được review nhưng chưa có brief — chạy "
                      f"`proto brief {proj_slug} {feat_slug} {prev_ver}` để gom kết quả làm đầu vào.", file=sys.stderr)

    ver_dir.mkdir(parents=True, exist_ok=True)
    meta_path = feat_dir / "meta.json"
    meta = {
        "project": proj_slug,
        "slug": feat_slug,
        "title": args.title or feat_slug,
        "domain": args.domain or "",
        "persona": args.persona or "",
        "approved_version": "",
        "versions": [],
    }
    if meta_path.is_file():
        try:
            loaded = json.loads(meta_path.read_text(encoding="utf-8"))
            meta.update(loaded)
        except Exception:
            pass

    if args.title:
        meta["title"] = args.title
    if args.domain:
        meta["domain"] = args.domain
    if args.persona:
        meta["persona"] = args.persona

    phase = normalize_phase(args.phase)
    stage = args.stage or ("phase" if phase else "")
    if not phase:
        print("[CẢNH BÁO] Chưa gắn --phase: phiên bản sẽ nằm ở mục 'Chưa gắn phase' trên Hub.", file=sys.stderr)
    warn_unknown_phase(proj_slug, phase)

    versions = [v for v in meta.get("versions", []) if v.get("version") != ver_slug]
    versions.append({
        "version": ver_slug,
        "created_at": now_iso(),
        "phase": phase,
        "stage": stage,
        "notes": args.notes or "",
        "rev": 1,
        "sealed": False,
    })
    meta["versions"] = versions
    meta_path.write_text(json.dumps(meta, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

    index_file = ver_dir / "index.html"
    if not index_file.exists():
        index_file.write_text(
            f"""<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{meta['title']} — {ver_slug}</title>
  <link rel="stylesheet" href="./styles.css" />
</head>
<body>
  <main style="padding: 32px; font-family: sans-serif;">
    <h1>{meta['title']} ({ver_slug})</h1>
    <p>Khung khởi tạo cho {proj_slug} / {feat_slug} / {ver_slug}</p>
  </main>
  <script src="./app.js"></script>
</body>
</html>
""",
            encoding="utf-8",
        )

    build_manifest()
    print(f"[OK] Đã khởi tạo phiên bản mới tại: {ver_dir}")


def cmd_promote(args: argparse.Namespace) -> None:
    proj_slug = args.project.strip()
    feat_slug = args.feature.strip()
    ver_slug = args.version.strip()
    target_project_dir = Path(args.to).expanduser().resolve()

    feat_dir = PROTOTYPES_DIR / proj_slug / feat_slug
    ver_dir = feat_dir / ver_slug

    if not ver_dir.is_dir() or not (ver_dir / "index.html").is_file():
        print(f"[LỖI] Không tìm thấy phiên bản '{proj_slug}/{feat_slug}/{ver_slug}' trong kho mockup.", file=sys.stderr)
        sys.exit(1)

    warns = review_gate_warnings(proj_slug, feat_slug, ver_slug, target_project_dir)
    if warns and not args.skip_review:
        print(f"[CHẶN CHỐT] {proj_slug}/{feat_slug}/{ver_slug}: " + "; ".join(warns) +
              ".\n  → Chạy review (proto review-prep …) hoặc bỏ qua có chủ đích bằng --skip-review (ghi lý do vào --notes).", file=sys.stderr)
        sys.exit(1)
    if warns:
        print("[CẢNH BÁO] Bỏ qua cổng review: " + "; ".join(warns), file=sys.stderr)

    meta_path = feat_dir / "meta.json"
    meta = {}
    if meta_path.is_file():
        meta = json.loads(meta_path.read_text(encoding="utf-8"))

    meta["approved_version"] = ver_slug
    meta["promoted_at"] = now_iso()
    meta["promoted_to"] = str(target_project_dir)
    meta_path.write_text(json.dumps(meta, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    build_manifest()

    # Copy sang <project>/docs/02-mockups/<feature-slug>/
    dest_mockups_root = target_project_dir / "docs" / "02-mockups"
    dest_feat_dir = dest_mockups_root / feat_slug
    if dest_feat_dir.exists():
        shutil.rmtree(dest_feat_dir)
    shutil.copytree(ver_dir, dest_feat_dir)
    carry_guide(proj_slug, feat_slug, ver_slug, ver_dir, dest_feat_dir)

    # Tạo SPEC-NOTES.md
    spec_tpl_path = TEMPLATES_DIR / "SPEC-NOTES.template.md"
    spec_tpl = spec_tpl_path.read_text(encoding="utf-8") if spec_tpl_path.is_file() else ""

    base_url = get_pages_base_url()
    history_lines = []
    for v in meta.get("versions", []):
        v_id = v.get("version", "")
        v_note = v.get("notes", "")
        marker = "✅ **[BẢN CHỐT]**" if v_id == ver_slug else "▫️ Bản nháp"
        link_str = f"([Xem trên Hub]({base_url}/viewer.html?project={proj_slug}&feature={feat_slug}&version={v_id}))" if base_url else ""
        history_lines.append(f"  - `{v_id}` — {marker}: {v_note} {link_str}".strip())

    ver_notes = args.notes or next((v.get("notes", "") for v in meta.get("versions", []) if v.get("version") == ver_slug), "Đã duyệt giao diện và tương tác.")
    assumed = [a for v in meta.get("versions", []) if v.get("version") == ver_slug for a in v.get("accepted", []) if a.get("kind") == "assumed"]
    if assumed:  # giả định chờ chuyên gia → mang sang phase doc dưới dạng "chốt tạm"
        ver_notes += "\n\n**Giả định chờ chuyên gia xác nhận (chốt tạm — có thể phải refactor):** " + \
            "; ".join(f"{a['id']} ({a.get('reason', '')})" for a in assumed)
        print(f"[INFO] {len(assumed)} giả định chờ chuyên gia được ghi vào SPEC-NOTES: {', '.join(a['id'] for a in assumed)}")

    spec_content = (
        spec_tpl.replace("{{FEATURE_TITLE}}", meta.get("title", feat_slug))
        .replace("{{FEATURE_SLUG}}", feat_slug)
        .replace("{{PROJECT_SLUG}}", proj_slug)
        .replace("{{APPROVED_VERSION}}", ver_slug)
        .replace("{{PROMOTED_AT}}", today_str())
        .replace("{{PERSONA}}", meta.get("persona", "N/A"))
        .replace("{{DOMAIN}}", meta.get("domain", "N/A"))
        .replace("{{VERSION_HISTORY_LIST}}", "\n".join(history_lines) if history_lines else f"  - `{ver_slug}`")
        .replace("{{NOTES}}", ver_notes)
    )
    (dest_feat_dir / "SPEC-NOTES.md").write_text(spec_content, encoding="utf-8")

    # Cập nhật README.md tại <project>/docs/02-mockups/README.md
    update_project_mockups_readme(dest_mockups_root, proj_slug, base_url)

    print(f"[OK] Đã chốt phiên bản '{ver_slug}' và chép sạch sẽ về: {dest_feat_dir}")


def update_project_mockups_readme(mockups_root: Path, proj_slug: str, base_url: str) -> None:
    rows = []
    for d in sorted(mockups_root.iterdir()):
        if not d.is_dir() or d.name.startswith("."):
            continue
        if not (d / "index.html").is_file():
            continue
        spec_file = d / "SPEC-NOTES.md"
        approved_ver = "N/A"
        persona = "N/A"
        if spec_file.is_file():
            for line in spec_file.read_text(encoding="utf-8").splitlines():
                if "Phiên bản được chốt" in line and "`" in line:
                    approved_ver = line.split("`")[1]
                elif "Đối tượng sử dụng" in line and "`" in line:
                    persona = line.split("`")[1]
        hub_link = f"[So sánh các bản nháp]({base_url}/viewer.html?project={proj_slug}&feature={d.name})" if base_url else "Trong kho mockup"
        rows.append(f"| `{d.name}` | `{persona}` | `{approved_ver}` | [index.html](./{d.name}/index.html) · [SPEC-NOTES.md](./{d.name}/SPEC-NOTES.md) | {hub_link} |")

    table_body = "\n".join(rows) if rows else "| *(Chưa có mockup nào được chốt)* | - | - | - | - |"
    readme_content = f"""# Danh mục Mockup Đã Chốt — `{proj_slug}`

> Thư mục này **chỉ lưu trữ các phiên bản thiết kế đã được duyệt (Approved)** để làm căn cứ triển khai code thực tế.
> Toàn bộ các phương án thử nghiệm (`v1`, `v2`, `v3`...) được lưu trữ tách biệt tại kho mockup (`~/.config/mockup/root`).

- **Định hướng thiết kế dự án**: Xem [DESIGN-CONTEXT.md](./DESIGN-CONTEXT.md)

## Danh sách Màn hình Đã Duyệt

| Mã tính năng (Feature) | Đối tượng (Persona) | Bản chốt từ | File tại dự án | Lịch sử & So sánh |
| :--- | :--- | :--- | :--- | :--- |
{table_body}
"""
    (mockups_root / "README.md").write_text(readme_content, encoding="utf-8")


PROJ_TABLE_BEGIN = "<!-- projects:begin -->"
PROJ_TABLE_END = "<!-- projects:end -->"


def register_project(slug: str, field: str, refs: list[str], path: Path) -> None:
    """Ghi 1 dòng mô tả lĩnh vực vào README kho mockup. Kho chỉ biết 'dự án này thuộc lĩnh vực gì' và
    'tham khảo dự án trước nào' — KHÔNG lưu kiến thức chuyên ngành (nằm ở repo dự án)."""
    readme = ROOT_DIR / "README.md"
    text = readme.read_text(encoding="utf-8")
    if PROJ_TABLE_BEGIN not in text or PROJ_TABLE_END not in text:
        print(f"[CẢNH BÁO] README kho mockup chưa có khối {PROJ_TABLE_BEGIN} … {PROJ_TABLE_END}; bỏ qua ghi lĩnh vực.", file=sys.stderr)
        return
    head, rest = text.split(PROJ_TABLE_BEGIN, 1)
    body, tail = rest.split(PROJ_TABLE_END, 1)
    lines = [l for l in body.strip("\n").splitlines()]
    header = ["| Dự án | Lĩnh vực | Tham khảo từ dự án trước |", "| :--- | :--- | :--- |"]
    rows = [l for l in lines[2:] if not l.startswith(f"| `{slug}`")]
    rows.append(f"| `{slug}` | {field or '—'} | {', '.join('`' + r + '`' for r in refs) or '—'} |")
    new = head + PROJ_TABLE_BEGIN + "\n" + "\n".join(header + sorted(rows)) + "\n" + PROJ_TABLE_END + tail
    if new != text:
        readme.write_text(new, encoding="utf-8")
        print(f"[OK] README kho mockup: ghi lĩnh vực của '{slug}' (kho không lưu tri thức chuyên ngành)")


def cmd_init_project(args: argparse.Namespace) -> None:
    target_dir = Path(args.project_path).expanduser().resolve()
    proj_slug = args.slug or target_dir.name
    domain_id = args.domain or "04-creative-editor"

    mockups_root = target_dir / "docs" / "02-mockups"
    mockups_root.mkdir(parents=True, exist_ok=True)

    ctx_file = mockups_root / "DESIGN-CONTEXT.md"
    if not ctx_file.exists() or args.force:
        tpl = (TEMPLATES_DIR / "DESIGN-CONTEXT.template.md").read_text(encoding="utf-8")
        content = (
            tpl.replace("{{PROJECT_NAME}}", proj_slug)
            .replace("{{PROJECT_SLUG}}", proj_slug)
            .replace("{{DOMAIN_ID}}", domain_id)
        )
        ctx_file.write_text(content, encoding="utf-8")
        print(f"[OK] Đã tạo {ctx_file}")
    else:
        print(f"[INFO] Đã tồn tại {ctx_file} (dùng --force nếu muốn tạo lại)")

    biz_file = business_pack_path(target_dir)
    if not biz_file.exists():
        biz_tpl = (TEMPLATES_DIR / "BUSINESS-REVIEW.template.md").read_text(encoding="utf-8")
        biz_file.write_text(biz_tpl.replace("{{PROJECT_NAME}}", proj_slug).replace("{{DATE}}", today_str()), encoding="utf-8")
        print(f"[OK] Đã tạo {biz_file} — gói nghiệp vụ cho Tầng 2, thuộc repo dự án (kho mockup không sở hữu). "
              f"Điền mục 1–3; xoá file nếu dự án không có nghiệp vụ chuyên ngành.")

    readme_file = mockups_root / "README.md"
    if not readme_file.exists():
        update_project_mockups_readme(mockups_root, proj_slug, get_pages_base_url())
        print(f"[OK] Đã tạo {readme_file}")

    if args.field or args.ref:
        register_project(proj_slug, args.field or "", args.ref or [], target_dir)

    link_stable_root()
    upsert_agent_block(target_dir, proj_slug)


# ---------------------------------------------------------------------------
# Tri thức: định dạng quy tắc có ID / trạng thái / nguồn
#
#   - **[D02-003]** ⏳ · 2026-11-19 · nguồn: optic-shop — Nội dung quy tắc
#   - **[D04-003]** ⛔ thay bởi CORE-002 · 2026-11-18 · nguồn: editor-platform — Nội dung cũ
#
#   ✅ áp dụng (đã đúng ở ≥ 2 dự án hoặc là tri thức nền)
#   ⏳ ứng viên (mới thấy ở 1 dự án — áp dụng mềm, DESIGN-CONTEXT dự án được phép ghi đè)
#   ⛔ đã bị thay thế — bỏ qua
# ---------------------------------------------------------------------------

STATUS_ACTIVE = "✅"
STATUS_CANDIDATE = "⏳"
STATUS_SUPERSEDED = "⛔"
MIN_PROJECTS_FOR_ACTIVE = 2

RULE_RE = re.compile(
    r"^- \*\*\[(?P<id>[A-Z0-9]+-\d{3})\]\*\* "
    r"(?P<status>✅|⏳|⛔)(?P<extra>[^·]*)· "
    r"(?P<date>\d{4}-\d{2}-\d{2}) · nguồn: (?P<sources>.+?) — (?P<text>.+)$"
)
LEARN_HEADING = "## Nhật ký Tích luỹ Kinh nghiệm"
LEARN_LEGEND = (
    "*(Ghi bằng `proto learn` — không sửa tay định dạng dòng. "
    "✅ áp dụng · ⏳ ứng viên (1 dự án, DESIGN-CONTEXT dự án được ghi đè) · ⛔ đã bị thay thế, bỏ qua)*"
)
PERSONA_PREFIX = {
    "consumer-reader": "PCR",
    "operator-admin": "POA",
    "creator-builder": "PCB",
    "executive-manager": "PEM",
}


def norm_text(s: str) -> str:
    return re.sub(r"\s+", " ", re.sub(r"[`*_~]", "", s)).strip().lower()


def parse_sources(raw: str) -> list[str]:
    return [s.strip() for s in raw.split(",") if s.strip()]


def source_projects(sources: list[str]) -> set[str]:
    """'optic-shop/00-full-mvp@v2' → 'optic-shop'."""
    return {s.split("/")[0].split("@")[0].strip() for s in sources if s.strip()}


def knowledge_target(scope: str, args: argparse.Namespace) -> tuple[Path, str]:
    """Trả về (file đích, tiền tố ID) theo phạm vi."""
    if scope == "core":
        return KNOWLEDGE_DIR / "core-anti-ai-slop.md", "CORE"
    if scope == "domain":
        if not args.domain:
            fail("--scope domain cần --domain (vd: 02-management-saas).")
        d = args.domain.removesuffix(".md")
        m = re.match(r"^(\d{2})-", d)
        if not m:
            fail(f"Mã domain không hợp lệ: {d}")
        return KNOWLEDGE_DIR / "domains" / f"{d}.md", f"D{m.group(1)}"
    if scope == "persona":
        if not args.persona:
            fail("--scope persona cần --persona (vd: operator-admin).")
        p = args.persona.removesuffix(".md")
        if p not in PERSONA_PREFIX:
            fail(f"Persona không hợp lệ: {p}. Chọn một trong: {', '.join(PERSONA_PREFIX)}")
        return KNOWLEDGE_DIR / "personas" / f"{p}.md", PERSONA_PREFIX[p]
    # scope == "project"
    return resolve_project_context(args), "PRJ"


def resolve_project_context(args: argparse.Namespace) -> Path:
    if args.project_path:
        base = Path(args.project_path).expanduser().resolve()
    elif args.project:
        base = (ROOT_DIR.parent / args.project).resolve()
    else:
        fail(
            "Mặc định bài học thuộc phạm vi DỰ ÁN — cần --project <slug> hoặc --project-path <đường-dẫn>.\n"
            "Chỉ dùng --scope domain|persona|core khi bài học đúng cho mọi dự án cùng loại."
        )
    ctx = base / "docs" / "02-mockups" / "DESIGN-CONTEXT.md"
    if not ctx.is_file():
        fail(f"Không thấy {ctx}. Chạy trước: proto init-project {base} --domain <mã-domain>")
    return ctx


def fail(msg: str) -> None:
    print(f"[LỖI] {msg}", file=sys.stderr)
    sys.exit(1)


def iter_knowledge_files(include_projects: bool = True) -> list[Path]:
    files = [KNOWLEDGE_DIR / "core-anti-ai-slop.md"]
    files += sorted((KNOWLEDGE_DIR / "domains").glob("*.md"))
    files += sorted((KNOWLEDGE_DIR / "personas").glob("*.md"))
    if include_projects:
        for proj in sorted(PROTOTYPES_DIR.iterdir()) if PROTOTYPES_DIR.is_dir() else []:
            ctx = ROOT_DIR.parent / proj.name / "docs" / "02-mockups" / "DESIGN-CONTEXT.md"
            if proj.is_dir() and ctx.is_file():
                files.append(ctx)
    return [f for f in files if f.is_file()]


def iter_rules(files: list[Path]):
    for f in files:
        for i, line in enumerate(f.read_text(encoding="utf-8").splitlines(), 1):
            m = RULE_RE.match(line)
            if m:
                yield f, i, m


def next_rule_id(path: Path, prefix: str) -> str:
    nums = [
        int(m.group("id").split("-")[1])
        for _, _, m in iter_rules([path])
        if m.group("id").startswith(prefix + "-")
    ]
    return f"{prefix}-{(max(nums) + 1 if nums else 1):03d}"


def append_rule(path: Path, line: str) -> None:
    content = path.read_text(encoding="utf-8")
    placeholder = "- *(Cập nhật các quyết định thiết kế riêng của dự án này tại đây)*"
    if placeholder in content:
        content = content.replace(placeholder + "\n", "").replace(placeholder, "")
    if "Nhật ký Tích luỹ Kinh nghiệm" not in content and "## 4. Quy tắc Riêng Đã Chốt" not in content:
        content = content.rstrip("\n") + f"\n\n---\n\n{LEARN_HEADING}\n{LEARN_LEGEND}\n"
    path.write_text(content.rstrip("\n") + "\n" + line + "\n", encoding="utf-8")


def mark_superseded(old_id: str, new_id: str, prefer: Path | None = None) -> Path | None:
    files = iter_knowledge_files()
    if old_id.startswith("PRJ-"):
        files = [prefer] if prefer else []  # PRJ-xxx chỉ có nghĩa trong dự án đang ghi
    for f in files:
        lines = f.read_text(encoding="utf-8").splitlines()
        for idx, line in enumerate(lines):
            m = RULE_RE.match(line)
            if m and m.group("id") == old_id:
                lines[idx] = (
                    f"- **[{old_id}]** {STATUS_SUPERSEDED} thay bởi {new_id} · {m.group('date')} · "
                    f"nguồn: {m.group('sources')} — {m.group('text')}"
                )
                f.write_text("\n".join(lines) + "\n", encoding="utf-8")
                return f
    return None


# ---------------------------------------------------------------------------
# Tích hợp dự án ↔ agent (Claude / Cursor / Antigravity)
# ---------------------------------------------------------------------------

STABLE_ROOT = Path.home() / ".config" / "mockup" / "root"
STABLE_ROOT_DISPLAY = "~/.config/mockup/root"
BLOCK_BEGIN = "<!-- mockup:begin"
BLOCK_END = "<!-- mockup:end -->"


def link_stable_root() -> None:
    """~/.config/mockup/root → kho mockup: dự án/hook/rule gọi qua đây, không ghi cứng đường dẫn máy."""
    try:
        STABLE_ROOT.parent.mkdir(parents=True, exist_ok=True)
        if STABLE_ROOT.is_symlink() or STABLE_ROOT.exists():
            if STABLE_ROOT.resolve() == ROOT_DIR:
                return
            STABLE_ROOT.unlink()
        STABLE_ROOT.symlink_to(ROOT_DIR)
        print(f"[OK] {STABLE_ROOT_DISPLAY} → {ROOT_DIR}")
    except OSError as e:
        print(f"[CẢNH BÁO] Không tạo được {STABLE_ROOT_DISPLAY}: {e}", file=sys.stderr)


def agent_block(proj_slug: str) -> str:
    base = get_pages_base_url()
    hub = (
        f"- Hub tổng quan: {base}/?project={proj_slug} · theo phase: {base}/?project={proj_slug}&phase=<Pxx>\n"
        if base else ""
    )
    return (
        f"{BLOCK_BEGIN} — sinh bởi `proto init-project`, sửa ở kho mockup rồi chạy lại lệnh; không sửa tay -->\n"
        "## Thiết kế UI/UX (Mockup)\n"
        "- Bối cảnh thiết kế: `docs/02-mockups/DESIGN-CONTEXT.md` · bản chốt: `docs/02-mockups/<màn-hình>/` (+ `SPEC-NOTES.md`).\n"
        f"- **Khi design** (tạo/sửa mockup, review UI): đọc `{STABLE_ROOT_DISPLAY}/skill/SKILL.md` và làm theo. "
        "Bản nháp KHÔNG đặt trong repo này mà ở kho mockup: "
        f"`{STABLE_ROOT_DISPLAY}/bin/proto new {proj_slug} <màn-hình> <version> --phase <Pxx>`.\n"
        "- **Khi code UI**: bám bản chốt trong `docs/02-mockups/` mà phase doc chỉ định; không tự sáng tác giao diện; "
        "chỗ nào lệch mockup → ghi lý do trong phase doc.\n"
        f"- Trạng thái design: `{STABLE_ROOT_DISPLAY}/bin/proto status --project {proj_slug} [--phase <Pxx>]`\n"
        "- **Review mockup độc lập** (trước khi người dùng thật xem): Tầng 1 skill `ui-ux-review`, Tầng 2 skill `business-review` "
        f"(đọc `docs/02-mockups/BUSINESS-REVIEW.md` của repo này) — bắt đầu bằng `{STABLE_ROOT_DISPLAY}/bin/proto review-prep {proj_slug} <màn-hình> <version>`. "
        "Kết quả ở `.ops/` của kho mockup (không commit); tri thức nghiệp vụ chỉ nằm trong repo này, không chép sang kho mockup.\n"
        "- **Sửa mockup theo kết quả review** (version chưa khóa): skill `mockup-fix` — chỉ khi người ra lệnh, đúng một bước rồi dừng. "
        f"Phân vai Designer/Fixer/Reviewer/người khóa và việc đổi agent giữa các bước: `{STABLE_ROOT_DISPLAY}/skill/REVIEW.md` §9.7; "
        f"xem bước kế tiếp: `{STABLE_ROOT_DISPLAY}/bin/proto next {proj_slug} <màn-hình> <version>`.\n"
        f"{hub}"
        f"{BLOCK_END}\n"
    )


def upsert_agent_block(target_dir: Path, proj_slug: str) -> None:
    """Chèn/cập nhật khối mockup vào AGENTS.md (Cursor, Antigravity, Codex…) và CLAUDE.md (Claude Code)."""
    block = agent_block(proj_slug)
    files = [target_dir / "AGENTS.md", target_dir / "CLAUDE.md"]
    if not any(f.is_file() for f in files):
        files = [target_dir / "AGENTS.md"]
    for f in files:
        if not f.is_file() and f.name == "CLAUDE.md":
            continue
        content = f.read_text(encoding="utf-8") if f.is_file() else ""
        if BLOCK_BEGIN in content and BLOCK_END in content:
            start = content.index(BLOCK_BEGIN)
            end = content.index(BLOCK_END) + len(BLOCK_END)
            new = content[:start] + block.rstrip("\n") + content[end:]
        else:
            new = (content.rstrip("\n") + "\n\n" if content.strip() else "") + block
        if new != content:
            f.write_text(new, encoding="utf-8")
            print(f"[OK] Đã cập nhật khối mockup trong {f}")
        else:
            print(f"[INFO] Khối mockup trong {f} đã mới nhất")


def project_slug_from_path(path: Path) -> str:
    ctx = path / "docs" / "02-mockups" / "DESIGN-CONTEXT.md"
    if ctx.is_file():
        m = re.search(r"Project Slug\*\*:\s*`([^`]+)`", ctx.read_text(encoding="utf-8"))
        if m:
            return m.group(1).strip()
    return path.name


def load_feature_meta(proj_slug: str) -> list[dict]:
    manifest = build_manifest_data()
    for p in manifest["projects"]:
        if p["slug"] == proj_slug:
            return p["features"]
    return []


def cmd_set_phase(args: argparse.Namespace) -> None:
    feat_dir = PROTOTYPES_DIR / args.project / args.feature
    meta_path = feat_dir / "meta.json"
    if not meta_path.is_file():
        fail(f"Không thấy {meta_path}")
    meta = json.loads(meta_path.read_text(encoding="utf-8"))
    phase = normalize_phase(args.phase)
    warn_unknown_phase(args.project, phase)
    targets = set(args.versions)
    known = {v.get("version") for v in meta.get("versions", [])}
    for v in sorted(targets - known):
        if not (feat_dir / v / "index.html").is_file():
            fail(f"Không có phiên bản {v} trong {feat_dir}")
        meta.setdefault("versions", []).append({"version": v, "created_at": "", "notes": ""})
    for v in meta["versions"]:
        if v.get("version") in targets:
            v["phase"] = phase
            v["stage"] = args.stage or v.get("stage") or ("phase" if phase else "")
            print(f"[OK] {args.project}/{args.feature}/{v['version']} → phase={phase or '∅'} stage={v['stage'] or '∅'}")
    meta_path.write_text(json.dumps(meta, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    build_manifest()


def feature_status(feat: dict, phase: str = "") -> dict | None:
    versions = feat.get("versions", [])
    if phase:
        versions = [v for v in versions if v.get("phase") == phase]
        if not versions:
            return None
    latest = versions[-1] if versions else {}
    approved = feat.get("approved_version", "")
    pending = bool(latest) and latest.get("version") != approved and not (
        phase and any(v["version"] == approved for v in versions)
    )
    return {"latest": latest, "approved": approved, "pending": pending, "count": len(versions)}


def cmd_status(args: argparse.Namespace) -> None:
    if args.project:
        slug = args.project
    else:
        slug = project_slug_from_path(Path(args.project_path or ".").expanduser().resolve())
    phase = normalize_phase(args.phase)
    feats = load_feature_meta(slug)
    base = get_pages_base_url()

    rows = []
    for f in feats:
        st = feature_status(f, phase)
        if st:
            rows.append((f, st))
    pending = [f["slug"] for f, st in rows if st["pending"]]
    approved = [f["slug"] for f, st in rows if st["approved"] and not st["pending"]]
    all_phases = sorted({ph for f in feats for ph in f.get("phases", [])}, key=phase_sort_key)
    hub = f"{base}/?project={slug}" + (f"&phase={phase}" if phase else "") if base else ""

    if args.brief:
        if not feats:
            print(f"[mockup] {slug}: chưa có mockup nào ở kho. Design màn hình đầu tiên → skill thiết kế (proto new … --phase <Pxx>).")
            return
        scope = f"phase {phase}" if phase else f"{len(feats)} màn hình, phase: {', '.join(all_phases) or 'chưa gắn'}"
        msg = f"[mockup] {slug} ({scope}): {len(approved)} đã chốt · {len(pending)} chờ review"
        if pending:
            msg += f" ({', '.join(pending[:4])}{'…' if len(pending) > 4 else ''})"
        print(msg + (f" · Hub: {hub}" if hub else ""))
        return

    if not rows:
        print(f"[INFO] {slug}: không có màn hình nào" + (f" trong phase {phase}." if phase else "."))
        return
    print(f"Dự án {slug}" + (f" · phase {phase}" if phase else f" · các phase: {', '.join(all_phases) or 'chưa gắn'}"))
    for f, st in rows:
        latest = st["latest"]
        state = "⏳ chờ review" if st["pending"] else ("✅ đã chốt" if st["approved"] else "· nháp")
        print(
            f"  {f['slug']:<28} {state:<14} mới nhất: {latest.get('version','-')} "
            f"[{latest.get('phase') or '∅'}] · bản chốt: {st['approved'] or '—'} · {st['count']} phiên bản"
        )
    if hub:
        print(f"Hub: {hub}")


def cmd_learn(args: argparse.Namespace) -> None:
    scope = args.scope
    if args.domain and args.persona and scope != "project":
        fail("Mỗi bài học chỉ ghi vào MỘT nơi. Chọn --scope domain HOẶC --scope persona.")

    rule_text = " ".join(args.rule.split())
    sources = [s.strip() for s in (args.source or []) if s.strip()]
    if scope == "project" and not sources:
        sources = [args.project or Path(args.project_path or ".").name]
    if not sources:
        fail("Cần --source <dự-án[/feature@version]> để biết bài học đến từ đâu (lặp lại cờ cho nhiều dự án).")

    target, prefix = knowledge_target(scope, args)

    # Chặn trùng lặp ở bất kỳ đâu trong tri thức chung + DESIGN-CONTEXT các dự án
    key = norm_text(rule_text)
    for f, ln, m in iter_rules(iter_knowledge_files() + [target]):
        if m.group("status") != STATUS_SUPERSEDED and norm_text(m.group("text")) == key:
            fail(f"Bài học đã tồn tại: {m.group('id')} ({f}:{ln}). Dùng 'proto confirm-rule {m.group('id')} --source <dự-án>' để bổ sung nguồn.")

    if scope == "project":
        status = STATUS_ACTIVE
    else:
        n = len(source_projects(sources))
        status = STATUS_ACTIVE if n >= MIN_PROJECTS_FOR_ACTIVE else STATUS_CANDIDATE

    new_id = next_rule_id(target, prefix)
    line = f"- **[{new_id}]** {status} · {today_str()} · nguồn: {', '.join(sources)} — {rule_text}"
    append_rule(target, line)
    print(f"[OK] {new_id} {status} → {target}")
    if status == STATUS_CANDIDATE:
        print(
            f"  ⏳ Ứng viên: mới có {len(source_projects(sources))} dự án. Khi dự án thứ {MIN_PROJECTS_FOR_ACTIVE} xác nhận, "
            f"chạy: proto confirm-rule {new_id} --source <dự-án>"
        )

    if args.supersedes:
        for old in args.supersedes:
            f = mark_superseded(old.strip(), new_id, prefer=target)
            print(f"[OK] {old} → ⛔ thay bởi {new_id} ({f})" if f else f"[CẢNH BÁO] Không tìm thấy {old}")


def cmd_confirm_rule(args: argparse.Namespace) -> None:
    rid = args.rule_id.strip()
    for f in iter_knowledge_files():
        lines = f.read_text(encoding="utf-8").splitlines()
        for idx, line in enumerate(lines):
            m = RULE_RE.match(line)
            if not m or m.group("id") != rid:
                continue
            if m.group("status") == STATUS_SUPERSEDED:
                fail(f"{rid} đã bị thay thế, không thể xác nhận.")
            sources = parse_sources(m.group("sources"))
            for s in args.source:
                if s.strip() and s.strip() not in sources:
                    sources.append(s.strip())
            status = m.group("status")
            if rid.startswith("PRJ-") or len(source_projects(sources)) >= MIN_PROJECTS_FOR_ACTIVE:
                status = STATUS_ACTIVE
            lines[idx] = f"- **[{rid}]** {status} · {m.group('date')} · nguồn: {', '.join(sources)} — {m.group('text')}"
            f.write_text("\n".join(lines) + "\n", encoding="utf-8")
            print(f"[OK] {rid} {status} · nguồn: {', '.join(sources)} ({f})")
            return
    fail(f"Không tìm thấy quy tắc {rid}.")


def cmd_lint_knowledge(_args: argparse.Namespace) -> None:
    errors: list[str] = []
    warnings: list[str] = []
    files = iter_knowledge_files()
    shared = [f for f in files if KNOWLEDGE_DIR in f.parents]
    project_slugs = {p.name for p in PROTOTYPES_DIR.iterdir() if p.is_dir()} if PROTOTYPES_DIR.is_dir() else set()

    def rel(p: Path) -> str:
        try:
            return str(p.relative_to(ROOT_DIR))
        except ValueError:
            return str(p)

    ids: dict[str, str] = {}
    texts: dict[str, str] = {}
    candidates = 0
    def id_key(f: Path, rid: str) -> str:
        # PRJ-xxx chỉ cần duy nhất trong từng dự án
        return f"{f}::{rid}" if rid.startswith("PRJ-") else rid

    for f, ln, m in iter_rules(files):
        rid, where = m.group("id"), f"{rel(f)}:{ln}"
        if id_key(f, rid) in ids:
            errors.append(f"ID trùng {rid}: {ids[id_key(f, rid)]} và {where}")
        ids[id_key(f, rid)] = where
        if m.group("status") == STATUS_SUPERSEDED:
            ref = re.search(r"thay bởi ([A-Z0-9]+-\d{3})", m.group("extra"))
            if not ref:
                errors.append(f"{where} ⛔ nhưng thiếu 'thay bởi <ID>'")
            continue
        if m.group("status") == STATUS_CANDIDATE:
            candidates += 1
        key = norm_text(m.group("text"))
        if key in texts:
            errors.append(f"Trùng nội dung: {texts[key]} và {where}")
        texts[key] = where
        if f in shared:
            low = m.group("text").lower()
            leaked = [s for s in project_slugs if s.lower() in low]
            if leaked:
                warnings.append(f"{where} {rid} nhắc tên dự án {leaked} — có vẻ là quy tắc riêng dự án")

    for f, ln, m in iter_rules(files):
        ref = re.search(r"thay bởi ([A-Z0-9]+-\d{3})", m.group("extra"))
        if ref and id_key(f, ref.group(1)) not in ids:
            errors.append(f"{rel(f)}:{ln} trỏ tới {ref.group(1)} không tồn tại")

    # Dòng bài học kiểu cũ (không ID) trong tri thức chung
    for f in shared:
        for ln, line in enumerate(f.read_text(encoding="utf-8").splitlines(), 1):
            if re.match(r"^- \*\*\[\d{4}-\d{2}-\d{2}\]\*\*", line):
                errors.append(f"{rel(f)}:{ln} bài học định dạng cũ (không có ID/nguồn)")

    for e in errors:
        print(f"[LỖI] {e}")
    for w in warnings:
        print(f"[CẢNH BÁO] {w}")
    print(
        f"[TỔNG KẾT] {len(ids)} quy tắc · {candidates} ứng viên ⏳ · "
        f"{len(errors)} lỗi · {len(warnings)} cảnh báo · {len(files)} file"
    )
    if errors:
        sys.exit(1)


def cmd_publish(args: argparse.Namespace) -> None:
    manifest = build_manifest()
    msg = args.message or f"chore(prototypes): update preview hub ({today_str()})"

    run_cmd(["git", "add", "."])
    status = run_cmd(["git", "status", "--porcelain"]).stdout.strip()
    if status:
        run_cmd(["git", "commit", "-m", msg])
        print(f"[OK] Đã commit: {msg}")
    else:
        print("[INFO] Không có thay đổi mới cần commit.")

    origin_check = run_cmd(["git", "remote", "get-url", "origin"], check=False)
    if origin_check.returncode != 0 or not origin_check.stdout.strip():
        print("[CẢNH BÁO] Chưa cấu hình git remote 'origin'. Chạy './bin/proto init-repo' để tạo repo GitHub & bật GitHub Pages.")
        return

    run_cmd(["git", "pull", "--rebase", "origin", "main"], check=False)
    push_res = run_cmd(["git", "push", "-u", "origin", "main"], check=False)
    if push_res.returncode != 0:
        print(f"[LỖI PUSH] {push_res.stderr}", file=sys.stderr)
        sys.exit(1)

    base_url = get_pages_base_url()
    print("[OK] Đã đẩy lên GitHub thành công!")
    if base_url:
        print(f"  → Trang chủ Gallery: {base_url}/")
        for p in manifest.get("projects", []):
            for f in p.get("features", []):
                if f.get("versions"):
                    latest = f["versions"][-1]["version"]
                    print(
                        f"  → [{p['slug']}/{f['slug']}] So sánh & Review: "
                        f"{base_url}/viewer.html?project={p['slug']}&feature={f['slug']}&version={latest}"
                    )


def cmd_init_repo(args: argparse.Namespace) -> None:
    if not (ROOT_DIR / ".git").is_dir():
        run_cmd(["git", "init", "-b", "main"])
        print("[OK] Đã khởi tạo Git repository (nhánh main).")

    build_manifest()
    run_cmd(["git", "add", "."])
    status = run_cmd(["git", "status", "--porcelain"]).stdout.strip()
    if status:
        run_cmd(["git", "commit", "-m", "feat: initialize prototype preview hub & domain-persona matrix"])

    origin_check = run_cmd(["git", "remote", "get-url", "origin"], check=False)
    if origin_check.returncode != 0 or not origin_check.stdout.strip():
        visibility = "--public" if args.public else "--private"
        repo_name = args.repo or "ai-prototype-host"
        print(f"[INFO] Đang tạo GitHub repository '{repo_name}' ({visibility})...")
        create_res = run_cmd(["gh", "repo", "create", repo_name, visibility, "--source=.", "--remote=origin", "--push"], check=False)
        if create_res.returncode != 0:
            print(f"[LỖI GH] {create_res.stderr}", file=sys.stderr)
            sys.exit(1)
        print("[OK] Đã tạo repo và push code lên GitHub.")

    # Kích hoạt GitHub Pages dùng GitHub Actions workflow
    remote_url = run_cmd(["git", "remote", "get-url", "origin"], check=False).stdout.strip()
    if "github.com" in remote_url:
        part = remote_url.split("github.com")[-1].lstrip(":/").removesuffix(".git")
        run_cmd(
            ["gh", "api", "-X", "POST", f"repos/{part}/pages", "-f", "build_type=workflow"],
            check=False,
        )
        run_cmd(
            ["gh", "api", "-X", "PUT", f"repos/{part}/pages", "-f", "build_type=workflow"],
            check=False,
        )
        print(f"[OK] Đã cấu hình GitHub Pages (build_type=workflow) cho {part}.")
        print(f"  → URL Preview Hub: {get_pages_base_url()}/")


def thin_review_skill(name: str) -> str:
    """Skill mỏng: giữ frontmatter của skill thật, thân chỉ trỏ về kho (link tương đối của bản gốc sẽ gãy nếu copy)."""
    src = (ROOT_DIR / "skill" / name / "SKILL.md").read_text(encoding="utf-8")
    m = re.match(r"^(---\n.*?\n---\n)", src, re.S)
    front = m.group(1) if m else f"---\nname: {name}\ndescription: Review mockup độc lập\n---\n"
    return (
        f"{front}\n# {name} (Thin Entrypoint)\n\n"
        f"Đọc và làm theo đúng một file: `{STABLE_ROOT_DISPLAY}/skill/{name}/SKILL.md` "
        f"(file đó tự dẫn tới phần còn lại — không đọc thêm từ đây). Chưa có đường dẫn: chạy "
        f"`<kho-mockup>/bin/proto init-project <dự-án>` một lần để tạo symlink.\n"
    )


def cmd_install_skill(args: argparse.Namespace) -> None:
    thin_src = ROOT_DIR / "skill" / "THIN-SKILL.md"
    if not thin_src.is_file():
        print(f"[LỖI] Không tìm thấy {thin_src}", file=sys.stderr)
        sys.exit(1)

    roots = [
        Path.home() / ".gemini" / "antigravity" / "skills",
        Path.home() / ".gemini" / "config" / "skills",
    ]
    if getattr(args, "claude", False):
        roots.append(Path.home() / ".claude" / "skills")
    for root in roots:
        dest = root / "mockup-studio" / "SKILL.md"
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(thin_src, dest)
        print(f"[OK] Đã cài đặt Global Skill mỏng tại: {dest}")
        for name in ("ui-ux-review", "business-review", "mockup-fix", "guide-demo"):
            d = root / name / "SKILL.md"
            d.parent.mkdir(parents=True, exist_ok=True)
            d.write_text(thin_review_skill(name), encoding="utf-8")
            print(f"[OK] Đã cài đặt Global Skill mỏng tại: {d}")


# ---------------------------------------------------------------------------
# Review độc lập 3 tầng (xem skill/REVIEW.md)
#   Tầng 0: proto review-prep  — lint tĩnh + packet.md        (script, tất định)
#   Tầng 1: skill ui-ux-review   → reviews/<f>/<v>/core-rN.md
#   Tầng 2: skill business-review → reviews/<f>/<v>/business-rN.md
#   Tầng 3: người dùng thật      → human.md ; proto brief → briefs/<p>/<f>/<v>.md
# Kết quả review (có thể chứa nghiệp vụ nhạy cảm) nằm ở .ops/ của kho mockup — KHÔNG commit (.gitignore).
# Brief (đầu vào version kế tiếp, đã lược dữ liệu nhạy cảm) nằm ở briefs/ — commit cùng kho mockup.
# Tri thức chuyên ngành (BUSINESS-REVIEW.md) thuộc repo DỰ ÁN; kho mockup không sở hữu.
# ---------------------------------------------------------------------------

FINDING_RE = re.compile(r"^- \[(BLOCKER|MAJOR|NIT|IDEA)\]\s+(?:([A-Z]-\d+)\s+)?(.+)$")
VERDICT_RE = re.compile(r"^VERDICT:\s*([A-Z_]+)\s*$")
VALID_VERDICTS = {"APPROVE_WITH_NOTES", "CHANGES_REQUESTED", "BLOCKER"}
LINT_CAP = 5


def project_dir_for(slug: str, path: str | None = None, required: bool = True) -> Path:
    pd = Path(path).expanduser().resolve() if path else ROOT_DIR.parent / slug
    if required and not pd.is_dir():
        fail(f"Không thấy thư mục dự án: {pd} (dùng --project-path nếu dự án không nằm cạnh kho mockup)")
    return pd


def business_pack_path(pd: Path) -> Path:
    return pd / "docs" / "02-mockups" / "BUSINESS-REVIEW.md"


OPS_DIR = Path(os.environ.get("MOCKUP_OPS_DIR", str(ROOT_DIR / ".ops"))).expanduser()
BRIEFS_DIR = ROOT_DIR / "briefs"


def reviews_dir_for(proj: str, feat: str, ver: str) -> Path:
    """Kết quả review (không commit): .ops/reviews/<project>/<feature>/<version>/"""
    return OPS_DIR / "reviews" / proj / feat / ver


def brief_path_for(proj: str, feat: str, ver: str) -> Path:
    """Brief đầu vào cho version kế tiếp (commit): briefs/<project>/<feature>/<version>.md"""
    return BRIEFS_DIR / proj / feat / f"{ver}.md"


def feature_meta(proj: str, feat: str) -> dict:
    p = PROTOTYPES_DIR / proj / feat / "meta.json"
    if not p.is_file():
        fail(f"Không thấy {p}")
    return json.loads(p.read_text(encoding="utf-8"))


def previous_version(meta: dict, ver: str) -> str:
    names = [v.get("version") for v in meta.get("versions", [])]
    return names[names.index(ver) - 1] if ver in names and names.index(ver) > 0 else ""


def round_files(rdir: Path, prefix: str) -> list[tuple[int, Path]]:
    out = []
    if rdir.is_dir():
        for f in rdir.glob(f"{prefix}-r*.md"):
            m = re.match(rf"^{prefix}-r(\d+)\.md$", f.name)
            if m:
                out.append((int(m.group(1)), f))
    return sorted(out)


def latest_report(rdir: Path, prefix: str) -> tuple[int, Path] | None:
    rounds = round_files(rdir, prefix)
    return rounds[-1] if rounds else None


def parse_report(path: Path) -> dict:
    text = path.read_text(encoding="utf-8")
    verdict = "UNSET"
    for line in text.splitlines():
        m = VERDICT_RE.match(line.strip())
        if m and m.group(1) in VALID_VERDICTS:
            verdict = m.group(1)
        break  # chỉ xét dòng không rỗng đầu tiên
    findings = []
    for line in text.splitlines():
        m = FINDING_RE.match(line.strip())
        if m and "Vấn đề: …" not in line and "màn hình › vùng" not in line:
            findings.append({"sev": m.group(1), "id": m.group(2) or "", "text": m.group(3).strip()})
    counts = {k: sum(1 for f in findings if f["sev"] == k) for k in ("BLOCKER", "MAJOR", "NIT", "IDEA")}
    return {"verdict": verdict, "findings": findings, "counts": counts, "text": text}


def md_section(text: str, heading_prefix: str) -> list[str]:
    lines, grab, out = text.splitlines(), False, []
    for ln in lines:
        if ln.startswith("## "):
            grab = ln[3:].strip().lower().startswith(heading_prefix.lower())
            continue
        if grab and ln.strip().startswith(("-", "1", "2", "3", "4", "5")) and ln.strip() not in ("-",):
            out.append(ln.strip())
    return out


def static_lint(ver_dir: Path) -> list[dict]:
    """Tầng 0: kiểm tra tất định, rẻ. Không thay được review của AI/người; chỉ bắt lỗi cơ học."""
    issues: list[dict] = []
    files = [f for f in sorted(ver_dir.rglob("*")) if f.is_file() and f.suffix in {".html", ".css", ".js"}
             and f.stat().st_size < 2_000_000 and "reviews" not in f.parts]
    texts = {f: f.read_text(encoding="utf-8", errors="ignore") for f in files}
    all_css = "\n".join(t for f, t in texts.items() if f.suffix in {".css", ".html"})

    def add(sev: str, f: Path, text: str, pos: int, msg: str) -> None:
        issues.append({"sev": sev, "file": str(f.relative_to(ver_dir)), "line": text.count("\n", 0, pos) + 1, "msg": msg})

    def scan(rule_sev: str, pattern: str, msg: str, only: set[str] | None = None, flags: int = re.I) -> None:
        hits = 0
        for f, t in texts.items():
            if only and f.suffix not in only:
                continue
            for m in re.finditer(pattern, t, flags):
                hits += 1
                if hits <= LINT_CAP:
                    add(rule_sev, f, t, m.start(), msg)
        if hits > LINT_CAP:
            issues.append({"sev": rule_sev, "file": "*", "line": 0, "msg": f"{msg} (+{hits - LINT_CAP} vị trí nữa)"})

    for f, t in texts.items():
        if f.suffix != ".html":
            continue
        if "<html" in t.lower() and not re.search(r"<html[^>]*\slang=", t, re.I):
            add("WARN", f, t, 0, "<html> thiếu thuộc tính lang (trình đọc màn hình/ngắt từ tiếng Việt)")
        if not re.search(r'<meta[^>]+name=["\']viewport', t, re.I):
            add("MAJOR", f, t, 0, "Thiếu <meta name=viewport> — mobile 390px sẽ vỡ")
        if not re.search(r"<title>\s*\S", t, re.I):
            add("WARN", f, t, 0, "Thiếu <title>")
    scan("MAJOR", r"user-scalable\s*=\s*(no|0)|maximum-scale\s*=\s*1(\.0)?\b", "Khoá zoom (user-scalable=no/maximum-scale=1) — vi phạm WCAG 1.4.4", {".html"})
    scan("WARN", r"<img\b(?![^>]*\balt=)[^>]*>", "<img> thiếu alt", {".html"})
    scan("WARN", r"<(?:input|select|textarea)\b(?![^>]*(?:aria-label|aria-labelledby|\bid=|type=[\"'](?:hidden|submit|button)))[^>]*>",
         "Ô nhập có thể thiếu nhãn (không aria-label/id để gắn <label>)", {".html"})
    scan("WARN", r"<(?:div|span)\b[^>]*\sonclick=", "Phần tử không ngữ nghĩa (div/span) làm nút bấm — dùng <button>/<a> để có focus + bàn phím", {".html"})
    scan("WARN", r"tabindex\s*=\s*[\"']?[1-9]", "tabindex dương làm hỏng thứ tự tab")
    scan("MAJOR", r"/Users/|file://|(?:src|href)\s*=\s*[\"']/(?!/)|url\(\s*[\"']?/(?!/)",
         "Đường dẫn tuyệt đối/gốc — sẽ hỏng trên GitHub Pages (core §2.1: dùng ./)")
    scan("WARN", r"lorem ipsum|john doe|jane smith|card title|\bitem\s*\d\b|sample text|test user|\bTODO\b|\bFIXME\b",
         "Nội dung giả/để dở (core §1.3)")
    scan("WARN", r"#6366f1|#8b5cf6|#667eea|#764ba2", "Màu tím/indigo mặc định của AI (core §1.1) — chỉ chấp nhận nếu thương hiệu yêu cầu")
    scan("WARN", r"font-size\s*:\s*(?:[0-9]|1[01])(?:\.\d+)?px", "Cỡ chữ < 12px khó đọc")
    scan("INFO", r"<(?:script|link)\b[^>]+(?:src|href)\s*=\s*[\"']https?://[^\"']+", "Tài nguyên ngoài (CDN/font) — cần mạng khi review")
    scan("WARN", r"\balert\(", "alert() — dùng toast/modal có style", {".js", ".html"})

    if not re.search(r":root\s*\{[^}]*--", all_css):
        issues.append({"sev": "WARN", "file": "*", "line": 0, "msg": "Không thấy bảng token CSS trong :root (core §2.2)"})
    if re.search(r"outline\s*:\s*(?:none|0)\b", all_css) and ":focus-visible" not in all_css:
        issues.append({"sev": "MAJOR", "file": "*", "line": 0, "msg": "Tắt outline nhưng không có :focus-visible thay thế — mất chỉ báo focus bàn phím"})
    if files and "@media" not in all_css:
        issues.append({"sev": "WARN", "file": "*", "line": 0, "msg": "Không có @media nào — kiểm tra responsive 768/390px"})
    if re.search(r"\b(?:transition|animation)\s*:", all_css) and "prefers-reduced-motion" not in all_css:
        issues.append({"sev": "INFO", "file": "*", "line": 0, "msg": "Có chuyển động nhưng không xử lý prefers-reduced-motion"})
    if not files:
        issues.append({"sev": "MAJOR", "file": "*", "line": 0, "msg": "Không có file html/css/js nào để kiểm"})
    return issues


# ── Hiệu chỉnh tại chỗ (revN) & khóa version — xem skill/REVIEW.md §9 ─────────────
AUTO_REV_MAX = 3   # agent chạy tự động tối đa tới rev3
HARD_REV_MAX = 4   # người xác nhận (--confirm-extra) mới được lên rev4; không hơn
FIX_ID_RE = re.compile(r"^[A-Z]-\d+$")
SCOPE_TIERS = {"ui": ("core",), "logic": ("business",), "both": ("core", "business")}


def version_entry(meta: dict, ver: str) -> dict | None:
    return next((v for v in meta.get("versions", []) if v.get("version") == ver), None)


def save_feature_meta(proj: str, feat: str, meta: dict) -> None:
    p = PROTOTYPES_DIR / proj / feat / "meta.json"
    p.write_text(json.dumps(meta, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def version_rev(entry: dict) -> int:
    try:
        return max(1, int(entry.get("rev") or 1))
    except (TypeError, ValueError):
        return 1


def load_revs(rdir: Path) -> dict:
    p = rdir / "revs.json"
    if p.is_file():
        try:
            return json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            return {}
    return {}


def record_review_rev(rdir: Path, tier: str, rnd: int, rev: int, agent: str = "") -> None:
    """Ghi 'báo cáo vòng rnd của tầng này review bản revN' (không commit, nằm cạnh báo cáo)."""
    data = load_revs(rdir)
    data.setdefault(tier, {})[str(rnd)] = rev
    if agent:
        data.setdefault("agents", {})[f"{tier}-r{rnd}"] = agent
    (rdir / "revs.json").write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def reviewed_rev(rdir: Path, tier: str, rnd: int) -> int:
    return int(load_revs(rdir).get(tier, {}).get(str(rnd), 1))  # báo cáo cũ chưa ghi → coi là rev1


def stale_tiers(entry: dict, rdir: Path) -> list[str]:
    """Tầng nào có báo cáo mới nhất nhưng đã có hiệu chỉnh chạm tầng đó sau lần review ấy."""
    out = []
    for t in ("core", "business"):
        lr = latest_report(rdir, t)
        if not lr:
            continue
        rr = reviewed_rev(rdir, t, lr[0])
        if any(r.get("rev", 0) > rr and t in SCOPE_TIERS.get(r.get("scope", "both"), ("core", "business"))
               for r in entry.get("revisions", [])):
            out.append(t)
    return out


def parse_ids(raw: str | None) -> list[str]:
    return [x.strip().upper() for x in (raw or "").split(",") if x.strip()]


def snapshot_rev(proj: str, feat: str, ver: str, rev: int) -> str:
    """Chốt trạng thái hiện tại của version thành git tag <p>/<f>/<v>@revN (commit cục bộ, không push)."""
    if not (ROOT_DIR / ".git").exists():
        fail("Kho mockup chưa là git repo — không chụp snapshot được (chạy `proto init-repo`).")
    rel = f"prototypes/{proj}/{feat}/{ver}"
    tag = f"{proj}/{feat}/{ver}@rev{rev}"
    try:
        if run_cmd(["git", "rev-parse", "-q", "--verify", f"refs/tags/{tag}"], check=False).returncode == 0:
            fail(f"Tag {tag} đã tồn tại — rev{rev} đã được chụp trước đó.")
        run_cmd(["git", "add", "--", rel])
        if run_cmd(["git", "diff", "--cached", "--quiet", "--", rel], check=False).returncode != 0:
            run_cmd(["git", "commit", "-m", f"chore(mockup): snapshot {proj}/{feat}/{ver} rev{rev}", "--", rel])
        run_cmd(["git", "tag", tag])
    except subprocess.CalledProcessError as e:
        fail(f"git lỗi khi chụp snapshot: {(e.stderr or e.stdout or '').strip()}")
    return tag


def append_revisions(ver_dir: Path, proj: str, feat: str, ver: str, block: str) -> Path:
    p = ver_dir / "REVISIONS.md"
    head = ""
    if not p.is_file():
        head = (f"# Nhật ký hiệu chỉnh — {proj}/{feat}/{ver}\n\n"
                "> Sửa tại chỗ theo finding review khi version CHƯA khóa (quy tắc: skill/REVIEW.md §9). "
                "File này được publish — chỉ ghi ID finding, không chép số liệu nhạy cảm hay nội dung nghiệp vụ độc quyền.\n\n")
    with p.open("a", encoding="utf-8") as fh:
        fh.write(head + block.rstrip() + "\n\n")
    return p


def review_prompt(tier: str, proj: str, feat: str, ver: str, packet: Path, out: Path, rev: int = 1) -> str:
    skill = "ui-ux-review" if tier == "core" else "business-review"
    again = (f"\nĐây là vòng review lại bản hiệu chỉnh rev{rev}: làm theo REVIEW.md §9 (kiểm phần thay đổi + hồi quy; giữ nguyên ID "
             f"finding còn lỗi; finding đã sửa ghi ở mục “Đã khắc phục ở vòng này”)." if rev > 1 else "")
    return (
        f"Bạn là REVIEWER ĐỘC LẬP (phiên mới, không liên quan người đã vẽ mockup). Chỉ đọc, không sửa `prototypes/**`.\n"
        f"Làm theo skill `{skill}`: {STABLE_ROOT_DISPLAY}/skill/{skill}/SKILL.md (skill tự dẫn tới phần còn lại).\n"
        f"Mục tiêu: {proj}/{feat}/{ver} (bản rev{rev}). Đọc packet: {packet}{again}\n"
        f"Ghi báo cáo vào: {out} — dòng đầu tiên là `VERDICT: …`, dòng thứ hai là `Revision: rev{rev}`; "
        f"mỗi finding đúng một dòng `- [SEVERITY] ID `vị trí` — …`."
    )


def cmd_review_prep(args: argparse.Namespace) -> None:
    proj, feat, ver = args.project.strip(), args.feature.strip(), args.version.strip()
    ver_dir = PROTOTYPES_DIR / proj / feat / ver
    if not (ver_dir / "index.html").is_file():
        fail(f"Không thấy phiên bản {proj}/{feat}/{ver} trong kho mockup.")
    meta = feature_meta(proj, feat)
    vinfo = next((v for v in meta.get("versions", []) if v.get("version") == ver), {})
    prev = previous_version(meta, ver)
    if vinfo and "rev" not in vinfo:  # version cũ (trước khi có quy trình rev) → đưa vào quy trình mới: rev1, chưa khóa
        vinfo["rev"], vinfo["sealed"] = 1, False
        save_feature_meta(proj, feat, meta)
    rev, sealed = version_rev(vinfo), bool(vinfo.get("sealed"))
    pd = project_dir_for(proj, args.project_path, required=False)
    rdir = reviews_dir_for(proj, feat, ver)
    rdir.mkdir(parents=True, exist_ok=True)
    tiers = ["core", "business"] if args.tier == "both" else [args.tier]
    if sealed:
        print(f"[CẢNH BÁO] {ver} đã KHÓA (đã tới tay người) — review thêm được nhưng không sửa tại chỗ; muốn đổi → `proto new` + brief.", file=sys.stderr)

    biz_pack = business_pack_path(pd)
    if "business" in tiers and not biz_pack.is_file():
        print(f"[CẢNH BÁO] Dự án chưa có {biz_pack} — Tầng 2 chưa chạy được. "
              f"Tạo từ templates/BUSINESS-REVIEW.template.md (hoặc `proto init-project`), hoặc ghi 'business: N/A — lý do' vào packet.", file=sys.stderr)

    lint = static_lint(ver_dir)
    order = {"MAJOR": 0, "WARN": 1, "INFO": 2}
    lint.sort(key=lambda i: (order.get(i["sev"], 3), i["file"], i["line"]))
    base = get_pages_base_url()
    domain, persona = meta.get("domain", ""), meta.get("persona", "")
    ctx = pd / "docs" / "02-mockups" / "DESIGN-CONTEXT.md"

    read_list = [
        f"- {ctx} (PRJ-*, bản sắc dự án) {'' if ctx.is_file() else '⚠️ CHƯA CÓ'}",
        f"- {KNOWLEDGE_DIR / 'personas' / (persona + '.md')}" if persona else "- (persona chưa gắn trong meta.json)",
        f"- {KNOWLEDGE_DIR / 'domains' / (domain + '.md')}" if domain else "- (domain chưa gắn trong meta.json)",
        f"- {KNOWLEDGE_DIR / 'core-anti-ai-slop.md'}",
    ]
    prev_lines = []
    if prev:
        prev_rdir = reviews_dir_for(proj, feat, prev)
        for pref in ("core", "business"):
            lr = latest_report(prev_rdir, pref)
            if lr:
                prev_lines.append(f"- Báo cáo {pref} bản trước: {lr[1]}")
        nb = brief_path_for(proj, feat, prev)
        prev_lines.append(f"- Brief bản trước ({prev}): {nb}" + ("" if nb.is_file() else " — ⚠️ CHƯA CÓ"))

    baselines = []
    if meta.get("approved_version") and meta.get("approved_version") != ver:
        baselines.append(f"{feat}/{meta['approved_version']} (bản chốt của chính màn hình này)")
    elif prev:
        baselines.append(f"{feat}/{prev} (phiên bản liền trước)")
    else:
        for other in sorted((PROTOTYPES_DIR / proj).iterdir()) if (PROTOTYPES_DIR / proj).is_dir() else []:
            om = other / "meta.json"
            if other.name != feat and om.is_file():
                try:
                    av = json.loads(om.read_text(encoding="utf-8")).get("approved_version")
                except Exception:
                    av = ""
                if av:
                    baselines.append(f"{other.name}/{av} (bản chốt của màn hình khác trong dự án)")
    baseline_md = "\n".join(f"- `{PROTOTYPES_DIR / proj / b.split(' ')[0]}/index.html` — {b}" for b in baselines) \
        or "- (chưa có bản chốt/bản trước để đối chiếu — ghi rõ trong báo cáo)"

    rounds = {t: (round_files(rdir, t)[-1][0] + 1 if round_files(rdir, t) else 1) for t in tiers}
    lint_md = "\n".join(f"- `{i['sev']}` {i['file']}{':' + str(i['line']) if i['line'] else ''} — {i['msg']}" for i in lint) or "- (không phát hiện gì)"
    counts = {k: sum(1 for i in lint if i["sev"] == k) for k in ("MAJOR", "WARN", "INFO")}
    files_md = "\n".join(
        f"- {f.relative_to(ver_dir)} ({f.stat().st_size // 1024} KB)"
        for f in sorted(ver_dir.rglob("*")) if f.is_file()
    )
    prompts = "\n\n".join(
        f"### Prompt cho reviewer {t} (r{rounds[t]})\n```text\n"
        + review_prompt(t, proj, feat, ver, rdir / "packet.md", rdir / f"{t}-r{rounds[t]}.md", rev) + "\n```"
        for t in tiers
    )
    agent = (getattr(args, "agent", "") or "").strip()
    for t in tiers:
        record_review_rev(rdir, t, rounds[t], rev, agent)
    last_rev = (vinfo.get("revisions") or [{}])[-1] if rev > 1 else {}
    if agent and last_rev.get("fixer", "").strip().lower() == agent.lower():
        print(f"[CẢNH BÁO] Agent `{agent}` vừa SỬA rev{rev} — luật độc lập (REVIEW.md §2) cần reviewer là phiên mới và nên khác agent/model "
              f"với người sửa. Đổi agent hoặc xác nhận có chủ đích.", file=sys.stderr)
    if rev > 1 and not last_rev.get("done") and not last_rev.get("skipped"):
        print(f"[CẢNH BÁO] Chưa có `proto fixed` cho rev{rev} — fixer chưa khai đã sửa/bỏ finding nào; review vẫn chạy được nhưng thiếu ngữ cảnh.", file=sys.stderr)
    rev_md = ""
    if rev > 1:
        declared = ""
        if last_rev.get("done") or last_rev.get("skipped"):
            sk = "; ".join(f"{k} ({v})" for k, v in (last_rev.get("skipped") or {}).items())
            declared = (f"- Fixer khai (rev{rev}{', agent ' + last_rev['fixer'] if last_rev.get('fixer') else ''}): "
                        f"đã sửa {', '.join(last_rev.get('done') or []) or '—'}" + (f" · KHÔNG sửa: {sk}" if sk else "") + "\n")
        prior = [f"- Báo cáo {t} gần nhất của chính version này: {lr[1]}"
                 for t in ("core", "business") if (lr := latest_report(rdir, t))]
        rev_md = (
            f"\n## Vòng hiệu chỉnh — đang ở rev{rev} (sửa tại chỗ theo finding, version chưa khóa)\n"
            "> Đây là vòng review lại. Làm theo REVIEW.md §9: kiểm **phần thay đổi** + hồi quy mục “Giữ nguyên”; giữ nguyên ID finding còn lỗi; "
            "finding đã sửa ghi ở mục “Đã khắc phục ở vòng này”. Không đòi thay đổi ngoài danh sách đã sửa.\n"
            f"- Nhật ký hiệu chỉnh: {ver_dir / 'REVISIONS.md'}\n"
            f"- Xem thay đổi: `git -C {ROOT_DIR} diff {proj}/{feat}/{ver}@rev{rev - 1} -- prototypes/{proj}/{feat}/{ver}`\n"
            + declared + "\n".join(prior) + "\n"
        )
    packet = f"""# Review Packet — {proj} / {feat} / {ver}

- **Sinh lúc**: {now_iso()} · **Phase**: {vinfo.get('phase') or '∅'} · **Stage**: {vinfo.get('stage') or '∅'}
- **Revision**: rev{rev} · {'🔒 đã khóa' if sealed else 'nháp (chưa khóa — sửa tại chỗ được theo finding, tối đa rev' + str(AUTO_REV_MAX) + ' tự động)'}
- **Persona**: `{persona or '∅'}` · **Domain**: `{domain or '∅'}` · **Bản chốt hiện hành**: `{meta.get('approved_version') or '—'}` · **Bản trước**: `{prev or '—'}`
- **Ghi chú version**: {vinfo.get('notes') or '(không có)'}
- **Xem**: {(base + f'/viewer.html?project={proj}&feature={feat}&version={ver}') if base else '(chưa có URL Pages)'} · local: `{ver_dir / 'index.html'}`
- **Gói nghiệp vụ (Tầng 2)**: {biz_pack if biz_pack.is_file() else '❌ chưa có — ghi `business: N/A — <lý do>` tại đây nếu màn hình không có nghiệp vụ chuyên ngành'}

## Tầng 0 — Lint tĩnh ({counts['MAJOR']} MAJOR · {counts['WARN']} WARN · {counts['INFO']} INFO)
> Chỉ bắt lỗi cơ học. Reviewer phải tự xác nhận trên bản render; không chép nguyên vào báo cáo nếu không tái hiện được.
{lint_md}

## Đọc theo thứ tự (ưu tiên khi mâu thuẫn: dự án > persona > domain > core)
{chr(10).join(read_list)}

## Baseline khung điều hướng (Shell Continuity — Tầng 1 bắt buộc đối chiếu)
> Tên menu, icon, thứ tự, layout shell phải giữ nguyên so với baseline, trừ khi brief/người dùng cho phép đổi.
{baseline_md}

## Từ vòng trước
{chr(10).join(prev_lines) if prev_lines else '- (đây là version đầu tiên của màn hình)'}
{rev_md}
## File của version
{files_md}

{prompts}
"""
    out = rdir / "packet.md"
    out.write_text(packet, encoding="utf-8")
    build_manifest()  # làm mới nhãn trạng thái review cho Hub
    print(f"[OK] Tầng 0 — lint: {counts['MAJOR']} MAJOR · {counts['WARN']} WARN · {counts['INFO']} INFO · bản rev{rev}")
    print(f"[OK] Packet: {out}")
    for t in tiers:
        print(f"→ Tầng {1 if t == 'core' else 2} ({t}): mở phiên MỚI, chạy skill "
              f"{'ui-ux-review' if t == 'core' else 'business-review'} → ghi {rdir / f'{t}-r{rounds[t]}.md'}")


def review_state(proj: str, pd: Path, feat: str, ver: str) -> dict:
    rdir = reviews_dir_for(proj, feat, ver)
    entry = version_entry(feature_meta(proj, feat), ver) or {}
    st: dict = {"packet": (rdir / "packet.md").is_file(), "human": (rdir / "human.md").is_file(),
                "brief": brief_path_for(proj, feat, ver).is_file(), "core": None, "business": None,
                "rev": version_rev(entry), "sealed": bool(entry.get("sealed")), "legacy": "rev" not in entry,
                "accepted": {a.get("id"): a for a in entry.get("accepted", [])}}
    open_items = []
    for t in ("core", "business"):
        lr = latest_report(rdir, t)
        if lr:
            rep = parse_report(lr[1])
            st[t] = {"round": lr[0], "verdict": rep["verdict"], "counts": rep["counts"], "rev": reviewed_rev(rdir, t, lr[0])}
            open_items += [{"id": f["id"], "sev": f["sev"], "tier": t} for f in rep["findings"]
                           if f["sev"] in ("BLOCKER", "MAJOR") and f["id"] not in st["accepted"]]
    st["open"] = open_items
    st["stale"] = stale_tiers(entry, rdir)
    st["needs_business"] = business_pack_path(pd).is_file()
    t1, t2 = st["core"], st["business"]
    blocked = any(i["sev"] == "BLOCKER" for i in open_items) or \
        any(x and x["verdict"] == "BLOCKER" and x["counts"]["BLOCKER"] == 0 for x in (t1, t2))
    st["blocked"] = blocked
    st["ready_for_human"] = bool(t1) and (bool(t2) or not st["needs_business"]) and not open_items and not st["stale"]
    return st


def fmt_tier(x: dict | None) -> str:
    if not x:
        return "—"
    c = x["counts"]
    return f"r{x['round']}@rev{x.get('rev', 1)} {x['verdict'].replace('_', ' ').lower()} ({c['BLOCKER']}B/{c['MAJOR']}M/{c['NIT']}N/{c['IDEA']}I)"


def review_summary(proj: str, feat: str, ver: str, entry: dict) -> dict:
    """Tóm tắt công khai cho Hub: chỉ vòng/rev/verdict/số lượng — KHÔNG có nội dung finding."""
    try:
        rdir = reviews_dir_for(proj, feat, ver)
        out: dict = {"core": None, "business": None}
        accepted = {a.get("id") for a in entry.get("accepted", [])}
        open_n = 0
        for t in ("core", "business"):
            lr = latest_report(rdir, t)
            if lr:
                rep = parse_report(lr[1])
                out[t] = {"round": lr[0], "rev": reviewed_rev(rdir, t, lr[0]), "verdict": rep["verdict"], "counts": rep["counts"]}
                open_n += sum(1 for f in rep["findings"] if f["sev"] in ("BLOCKER", "MAJOR") and f["id"] not in accepted)
        out["stale"] = stale_tiers(entry, rdir)
        out["open"] = open_n
        return out
    except Exception:
        return {}


def cmd_review_status(args: argparse.Namespace) -> None:
    pd = project_dir_for(args.project, args.project_path, required=False)
    feats = [f for f in load_feature_meta(args.project) if not args.feature or f["slug"] == args.feature]
    rows = []
    for f in feats:
        vers = f.get("versions", [])
        for v in (vers if args.all else vers[-1:]):
            rows.append((f["slug"], v["version"], review_state(args.project, pd, f["slug"], v["version"])))
    if args.brief:
        pend = [f"{s}@{v}" for s, v, st in rows if not st["ready_for_human"]]
        blocked = [f"{s}@{v}" for s, v, st in rows if st["blocked"]]
        msg = f"[review] {args.project}: {len(rows) - len(pend)}/{len(rows)} bản mới nhất sẵn sàng cho người dùng thật"
        if blocked:
            msg += f" · BLOCKER: {', '.join(blocked[:3])}"
        elif pend:
            msg += f" · chờ review AI: {', '.join(pend[:3])}{'…' if len(pend) > 3 else ''}"
        print(msg)
        return
    if not rows:
        print(f"[INFO] {args.project}: chưa có màn hình nào.")
        return
    print(f"Review — {args.project}   (T0 packet · T1 ui-ux · T2 nghiệp vụ · T3 người dùng · brief)")
    for s, v, st in rows:
        t2 = fmt_tier(st["business"]) if (st["needs_business"] or st["business"]) else "n/a (chưa có BUSINESS-REVIEW.md)"
        if st["sealed"]:
            flag = "🔒 đã khóa (đã tới tay người)"
        elif st["blocked"]:
            flag = "⛔ còn BLOCKER chưa xử lý/chấp nhận"
        elif st["stale"]:
            flag = f"🔁 đã sửa sau review — cần review lại: {', '.join(st['stale'])}"
        elif st["open"]:
            flag = f"⚠️ còn {len(st['open'])} BLOCKER/MAJOR chưa sửa/chấp nhận ({', '.join(i['id'] or '?' for i in st['open'][:5])})"
        elif st["ready_for_human"]:
            flag = "✅ qua cổng máy — người có thể `proto seal` rồi gửi link"
        else:
            flag = "⏳ chờ review AI"
        print(f"  {s}/{v}  [rev{st['rev']}]\n    T0 {'✓' if st['packet'] else '—'} · T1 {fmt_tier(st['core'])} · T2 {t2} · "
              f"T3 {'✓' if st['human'] else '—'} · brief {'✓' if st['brief'] else '—'}   {flag}")


def cmd_brief(args: argparse.Namespace) -> None:
    proj, feat, ver = args.project.strip(), args.feature.strip(), args.version.strip()
    rdir = reviews_dir_for(proj, feat, ver)
    rdir.mkdir(parents=True, exist_ok=True)
    meta = feature_meta(proj, feat)
    vinfo = next((v for v in meta.get("versions", []) if v.get("version") == ver), {})

    accepted_map = {a.get("id"): a for a in (vinfo.get("accepted") or [])}
    human = rdir / "human.md"
    if args.human and "rev" in vinfo and not vinfo.get("sealed"):
        print(f"[CẢNH BÁO] {ver} chưa `proto seal` mà đã có phản hồi người thật — nên khóa trước để ghi nhận mốc "
              f"(từ đây mọi thay đổi là version mới).", file=sys.stderr)
    if args.human:
        head ="" if human.is_file() else f"# Phản hồi người dùng thật (Tầng 3) — {proj}/{feat}/{ver}\n\n"
        with human.open("a", encoding="utf-8") as fh:
            fh.write(head + "".join(f"- [{today_str()}] {h}\n" for h in args.human))
        print(f"[OK] Đã ghi {len(args.human)} phản hồi vào {human}")

    out = brief_path_for(proj, feat, ver)
    out.parent.mkdir(parents=True, exist_ok=True)
    if out.exists() and not args.force:
        fail(f"{out} đã tồn tại (quyết định Adopt/Defer/Reject có thể đã được điền). Dùng --force để sinh lại, hoặc sửa tay file đó.")

    rows, ideas, keep, questions, sources = [], [], [], [], []
    for prefix, tag in (("core", "T1"), ("business", "T2")):
        lr = latest_report(rdir, prefix)
        if not lr:
            continue
        rep = parse_report(lr[1])
        sources.append(f"{prefix}-r{lr[0]} ({rep['verdict']})")
        for f in rep["findings"]:
            ftxt = f["text"]
            if prefix == "business":
                mb = re.search(r"Brief:\s*(.+)$", ftxt)
                if mb:
                    ftxt = mb.group(1).strip() + f" *(chi tiết: .ops/reviews/…/business-r{lr[0]}.md)*"
                else:
                    ftxt = f"⚠️ finding thiếu phần `Brief:` — xem báo cáo business-r{lr[0]}.md trong .ops/ và viết lại yêu cầu thiết kế đã lược dữ liệu nhạy cảm"
                    print(f"[CẢNH BÁO] {f['id'] or f['sev']} (business) thiếu 'Brief:' — brief chỉ ghi placeholder, không chép nguyên văn.", file=sys.stderr)
            txt = ftxt.replace("|", "\\|")
            if f["sev"] == "IDEA":
                ideas.append(f"| {f['id'] or '—'} | {txt} | ? | ? | ⬜ |")
            else:
                acc = accepted_map.get(f["id"])
                if acc:  # người đã cho qua có chủ đích khi khóa → mặc định Defer, ghi lý do
                    kind = "giả định chờ chuyên gia" if acc.get("kind") == "assumed" else "chấp nhận có chủ đích"
                    rows.append(f"| {f['id']} | {f['sev']} | {tag} | {txt} | Defer | đã {kind} khi khóa: {acc.get('reason', '')} |".replace("\n", " "))
                    continue
                dec = "Adopt" if f["sev"] in ("BLOCKER", "MAJOR") else "⬜"
                rows.append(f"| {f['id'] or '—'} | {f['sev']} | {tag} | {txt} | {dec} | |")
        keep += [f"- {l.lstrip('-').strip()}" for l in md_section(rep["text"], "Đã kiểm & sạch")]
        for l in md_section(rep["text"], "Câu hỏi cho chuyên gia"):
            if "không có" not in l.lower():
                questions.append("- " + re.sub(r"^[-0-9.\s]+", "", l))
    if not sources:
        print("[CẢNH BÁO] Chưa có báo cáo core-r*/business-r* — brief chỉ chứa phần phản hồi người dùng.", file=sys.stderr)
    human_items = [l.strip() for l in human.read_text(encoding="utf-8").splitlines() if l.strip().startswith("- ")] if human.is_file() else []
    if human_items:
        sources.append("human.md")

    tpl = (TEMPLATES_DIR / "NEXT-BRIEF.template.md").read_text(encoding="utf-8")
    content = (
        tpl.replace("{{PROJECT}}", proj).replace("{{FEATURE}}", feat).replace("{{VERSION}}", ver)
        .replace("{{PHASE}}", vinfo.get("phase") or "<Pxx>").replace("{{DATE}}", today_str())
        .replace("{{SOURCES}}", ", ".join(sources) or "—")
        .replace("{{FINDINGS_TABLE}}", "\n".join(rows) or "| — | — | — | (không có finding) | — | |")
        .replace("{{IDEAS_TABLE}}", "\n".join(ideas) or "| — | (không có) | — | — | — |")
        .replace("{{HUMAN_ITEMS}}", "\n".join(human_items) or "- *(chưa có — ghi bằng `proto brief … --human \"…\"` hoặc sửa `human.md`)*")
    )
    content = content.replace("- <điền từ \"Đã kiểm & sạch\" của các báo cáo + điều người dùng khen>",
                              "\n".join(keep) or "- <điền>")
    if questions:
        content = content.replace("- <từ mục \"Câu hỏi cho chuyên gia thật\">", "\n".join(questions))
    out.write_text(content, encoding="utf-8")
    print(f"[OK] {out}  ({len(rows)} việc · {len(ideas)} ý tưởng · {len(human_items)} phản hồi người dùng)")
    print("→ Điền cột Quyết định + 'Mục tiêu version tới', rồi `proto new` — version mới phải đọc file này.")


def review_gate_warnings(proj: str, feat: str, ver: str, pd: Path) -> list[str]:
    st = review_state(proj, pd, feat, ver)
    msgs = []
    if not st["core"]:
        msgs.append("chưa có báo cáo Tầng 1 (ui-ux-review)")
    if st["needs_business"] and not st["business"]:
        msgs.append("chưa có báo cáo Tầng 2 (business-review) dù dự án có BUSINESS-REVIEW.md")
    if st["stale"]:
        msgs.append(f"bản đã đổi sau lần review cuối — cần review lại tầng: {', '.join(st['stale'])}")
    if st["blocked"]:
        msgs.append("còn BLOCKER chưa xử lý/chấp nhận")
    elif st["open"]:
        msgs.append(f"còn MAJOR chưa sửa/chấp nhận ({', '.join(i['id'] or '?' for i in st['open'][:5])})")
    if not st["legacy"] and not st["sealed"]:
        msgs.append("chưa qua cổng người (`proto seal`)")
    return msgs


def latest_finding_ids(rdir: Path) -> dict[str, str]:
    """ID → mức của mọi finding (trừ IDEA) trong báo cáo mới nhất của mỗi tầng."""
    out: dict[str, str] = {}
    for t in ("core", "business"):
        lr = latest_report(rdir, t)
        if lr:
            for f in parse_report(lr[1])["findings"]:
                if f["id"] and f["sev"] != "IDEA":
                    out[f["id"]] = f["sev"]
    return out


def fix_prompt(proj: str, feat: str, ver: str, rev: int, packet: Path) -> str:
    return (
        f"Bạn là FIXER (phiên mới, không phải reviewer của vòng này). Làm theo skill `mockup-fix`: "
        f"{STABLE_ROOT_DISPLAY}/skill/mockup-fix/SKILL.md (file đó tự dẫn tới phần còn lại).\n"
        f"Mục tiêu: {proj}/{feat}/{ver} — sửa tại chỗ lên rev{rev}. Đọc fix packet: {packet}\n"
        f"Chỉ sửa đúng các finding trong packet, chỉ trong thư mục version. Sửa xong chạy `proto fixed` (lệnh có trong packet) rồi DỪNG và báo; "
        f"KHÔNG chạy review, KHÔNG `proto seal`, KHÔNG tạo version mới."
    )


def build_fix_packet(proj: str, feat: str, ver: str, cur: int, nxt: int, ids: list[str], scope: str,
                     rdir: Path, ver_dir: Path, note: str) -> str:
    """Gói việc cho FIXER: agent-agnostic, tự đủ. Chứa nguyên văn finding cần sửa (từ báo cáo mới nhất của mỗi tầng)."""
    rows, keep = [], []
    for t, tag in (("core", "T1"), ("business", "T2")):
        lr = latest_report(rdir, t)
        if not lr:
            continue
        rep = parse_report(lr[1])
        for f in rep["findings"]:
            if f["id"] in ids:
                rows.append(f"- [{f['sev']}] {f['id']} ({tag} · {lr[1].name}) {f['text']}")
        keep += [f"- {l.lstrip('-').strip()}" for l in md_section(rep["text"], "Đã kiểm & sạch")]
    missing = [i for i in ids if not any(f" {i} " in r for r in rows)]
    cmd_fixed_ex = f"proto fixed {proj} {feat} {ver} --done {','.join(ids)} [--skip ID --why \"lý do\"] --agent <tên-agent>"
    return f"""# Fix Packet — {proj} / {feat} / {ver} · rev{cur} → rev{nxt}

- **Sinh lúc**: {now_iso()} · **Phạm vi review lại**: {scope} · **Ghi chú**: {note or '—'}
- **Thư mục được sửa (và CHỈ thư mục này)**: `{ver_dir}`
- **Nhật ký hiệu chỉnh**: `{ver_dir / 'REVISIONS.md'}` (đã có mục rev{nxt}) · **Snapshot trước khi sửa**: git tag `{proj}/{feat}/{ver}@rev{cur}`
- Quy trình đầy đủ (chỉ đọc khi cần): `{STABLE_ROOT_DISPLAY}/skill/REVIEW.md` §9 · vai Fixer: `{STABLE_ROOT_DISPLAY}/skill/mockup-fix/SKILL.md`

## Việc cần làm — sửa ĐÚNG các finding sau (không thêm việc ngoài danh sách)
{chr(10).join(rows) or '- (không trích được nội dung finding — đọc trực tiếp báo cáo mới nhất ở ' + str(rdir) + ')'}
{('> Không thấy trong báo cáo mới nhất: ' + ', '.join(missing)) if missing and rows else ''}

## Giữ nguyên (không được phá khi sửa)
- Khung điều hướng (tên menu, icon, thứ tự, layout shell), bố cục và luồng chính, token đã chốt trong DESIGN-CONTEXT.
{chr(10).join(keep) or ''}

## Ranh giới — gặp là DỪNG và báo người (không tự quyết)
- Cần đổi shell / bố cục / luồng / cấu trúc dữ liệu để sửa được finding → không làm; ghi vào `--skip ID --why "cần version mới"`.
- Finding cần chuyên gia mà chưa có đáp án → không đoán; `--skip ID --why "chờ chuyên gia"` (người sẽ `--assume` khi khóa).
- Không chạy review, không `proto seal`, không `proto new`, không `proto publish`, không sửa file ngoài thư mục trên, không sửa `BUSINESS-REVIEW.md`.

## Khi xong
```bash
{cmd_fixed_ex}
```
Rồi báo người: finding nào đã sửa, finding nào bỏ (vì sao), file đã đổi. Dừng — người quyết định bước review lại.
"""


def cmd_fixed(args: argparse.Namespace) -> None:
    """Fixer khai kết quả sau khi sửa (agent nào cũng gọi được) → ghi REVISIONS.md; không chạy review."""
    proj, feat, ver = args.project.strip(), args.feature.strip(), args.version.strip()
    meta = feature_meta(proj, feat)
    entry = version_entry(meta, ver)
    if entry is None or not entry.get("revisions"):
        fail(f"{ver} chưa có hiệu chỉnh nào đang mở — chạy `proto revise` trước.")
    if entry.get("sealed"):
        fail(f"{ver} đã khóa — không khai kết quả sửa.")
    rec = entry["revisions"][-1]
    if rec.get("rev") != version_rev(entry):
        fail("Bản ghi hiệu chỉnh cuối không khớp rev hiện tại.")
    planned = set(rec.get("fixes", []))
    done, skip = parse_ids(args.done), parse_ids(args.skip)
    stray = [i for i in done + skip if i not in planned]
    if stray:
        fail(f"ID không nằm trong danh sách sửa của rev{rec['rev']}: {', '.join(stray)} (đã khai: {', '.join(sorted(planned))}). "
             f"Sửa ngoài danh sách = ngoài phạm vi hiệu chỉnh.")
    if skip and not (args.why or "").strip():
        fail("Bỏ finding phải nói lý do: --why \"…\" (vd: cần version mới / chờ chuyên gia).")
    left = sorted(planned - set(done) - set(skip))
    rec["done"] = done
    rec["skipped"] = {i: args.why.strip() for i in skip}
    if args.agent:
        rec["fixer"] = args.agent.strip()
    save_feature_meta(proj, feat, meta)
    lines = [f"### rev{rec['rev']} — kết quả sửa ({today_str()}{', agent ' + rec['fixer'] if rec.get('fixer') else ''})",
             f"- Đã sửa: {', '.join(done) or '—'}"]
    if skip:
        lines.append(f"- Không sửa: {', '.join(skip)} — {args.why.strip()}")
    if left:
        lines.append(f"- Chưa khai: {', '.join(left)}")
    append_revisions(PROTOTYPES_DIR / proj / feat / ver, proj, feat, ver, "\n".join(lines) + "\n")
    build_manifest()
    print(f"[OK] rev{rec['rev']}: đã sửa {len(done)} · bỏ {len(skip)} · chưa khai {len(left)}" + (f" ({', '.join(left)})" if left else ""))
    print("→ DỪNG. Báo người kết quả; review lại chỉ khi người ra lệnh.")


def cmd_next(args: argparse.Namespace) -> None:
    """Chỉ đọc: cho biết version đang ở đâu và các bước kế tiếp (người chọn; agent không tự nối)."""
    proj, feat, ver = args.project.strip(), args.feature.strip(), args.version.strip()
    meta = feature_meta(proj, feat)
    entry = version_entry(meta, ver)
    if entry is None:
        fail(f"{ver} chưa có trong meta.json của {feat}.")
    pd = project_dir_for(proj, args.project_path, required=False)
    st = review_state(proj, pd, feat, ver)
    last = (entry.get("revisions") or [{}])[-1] if st["rev"] > 1 else {}
    pp = f" --project-path {args.project_path}" if args.project_path else ""
    base = f"{proj} {feat} {ver}"
    print(f"{base} · rev{st['rev']} · {'🔒 ĐÃ KHÓA' if st['sealed'] else 'nháp (chưa khóa)'}")
    print(f"  T1 {fmt_tier(st['core'])} · T2 {fmt_tier(st['business']) if (st['needs_business'] or st['business']) else 'n/a'}")
    steps: list[tuple[str, str, str]] = []  # (vai, mô tả, lệnh)
    if st["sealed"]:
        steps.append(("Người", "Gửi link cho người trong dự án / chuyên gia; sau phản hồi:",
                      f"proto brief {base} --human \"…\"  →  rồi `proto new` version mới"))
    else:
        for t, label in (("core", "Tầng 1"), ("business", "Tầng 2")):
            if not st[t] and (t == "core" or st["needs_business"]):
                steps.append(("Reviewer", f"{label} chưa có báo cáo — mở phiên MỚI:", f"proto review-prep {base} --tier {t}{pp} [--agent <tên>]"))
        for t in st["stale"]:
            steps.append(("Reviewer", f"{'Tầng 1' if t == 'core' else 'Tầng 2'} lỗi thời (đã sửa sau lần review cuối) — review lại ở phiên MỚI:",
                          f"proto review-prep {base} --tier {t}{pp} [--agent <tên>]"))
        if st["rev"] > 1 and not (last.get("done") or last.get("skipped")):
            steps.append(("Fixer", f"rev{st['rev']} đang mở nhưng chưa khai kết quả — fixer chạy sau khi sửa xong:",
                          f"proto fixed {base} --done ID,… [--skip ID --why \"…\"] --agent <tên>"))
        if st["open"]:
            ids = ",".join(i["id"] for i in st["open"] if i["id"])
            nxt = st["rev"] + 1
            gate = "" if nxt <= AUTO_REV_MAX else f" --confirm-extra \"<lý do — chỉ khi người đã xác nhận>\"" if nxt <= HARD_REV_MAX else ""
            if nxt > HARD_REV_MAX:
                steps.append(("Người", f"Đã tới trần rev{HARD_REV_MAX} — còn {len(st['open'])} BLOCKER/MAJOR: tạo version mới kèm brief, hoặc cho qua:",
                              f"proto seal {base} --by <tên> --accept|--assume {ids} --reason \"…\"{pp}"))
            else:
                steps.append(("Fixer", f"Còn {len(st['open'])} BLOCKER/MAJOR — sửa tại chỗ (rev{nxt}):", f"proto revise {base} --fixes {ids}{gate}"))
                steps.append(("Người", "…hoặc cho qua có chủ đích (chấp nhận / giả định chờ chuyên gia):",
                              f"proto seal {base} --by <tên> --accept|--assume {ids} --reason \"…\"{pp}"))
        elif st["ready_for_human"]:
            steps.append(("Người", "Qua cổng máy — khóa rồi gửi link:", f"proto seal {base} --by <tên>{pp}"))
    print("Bước kế tiếp (người chọn MỘT; mỗi bước một phiên agent mới, agent không tự nối bước sau):")
    for i, (role, desc, cmd) in enumerate(steps, 1):
        print(f"  {i}. [{role}] {desc}\n       {cmd}")
    if not steps:
        print("  (không có bước tự động nào — xem review-status)")
    fixer = last.get("fixer")
    if fixer and not st["sealed"]:
        print(f"  Gợi ý độc lập: rev{st['rev']} do `{fixer}` sửa → nên để agent/model KHÁC review (REVIEW.md §9.7).")


def cmd_revise(args: argparse.Namespace) -> None:
    """Mở bản hiệu chỉnh kế tiếp: chụp snapshot revN hiện tại rồi ghi nhận sẽ sửa theo finding nào.
    Lệnh KHÔNG sửa mockup và KHÔNG tự chạy review — người ra lệnh từng bước."""
    proj, feat, ver = args.project.strip(), args.feature.strip(), args.version.strip()
    ver_dir = PROTOTYPES_DIR / proj / feat / ver
    if not (ver_dir / "index.html").is_file():
        fail(f"Không thấy phiên bản {proj}/{feat}/{ver} trong kho mockup.")
    meta = feature_meta(proj, feat)
    entry = version_entry(meta, ver)
    if entry is None:
        fail(f"{ver} chưa có trong meta.json của {feat}.")
    if entry.get("sealed"):
        fail(f"{ver} đã KHÓA (đã tới tay người) — không sửa tại chỗ. Tạo version mới: `proto brief {proj} {feat} {ver}` rồi `proto new`.")
    rdir = reviews_dir_for(proj, feat, ver)
    known = latest_finding_ids(rdir)
    if not known:
        fail(f"Chưa có báo cáo review nào cho {ver} — hiệu chỉnh chỉ để sửa theo finding của review (REVIEW.md §9).")

    cur = version_rev(entry)
    nxt = cur + 1
    if nxt > HARD_REV_MAX:
        fail(f"Đã tới rev{cur} — trần là rev{HARD_REV_MAX}. Còn vấn đề cấu trúc → tạo version mới kèm brief.")
    if nxt > AUTO_REV_MAX and not args.confirm_extra:
        fail(f"rev{nxt} vượt mức tự động (rev{AUTO_REV_MAX}). Cần NGƯỜI xác nhận trong chat rồi chạy lại kèm "
             f"--confirm-extra \"<lý do>\" (agent không tự thêm cờ này).")

    raw = parse_ids(args.fixes)
    ids = sorted(known) if raw == ["ALL"] else raw
    if not ids:
        fail("Cần --fixes ID1,ID2 (hoặc --fixes all) — mỗi thay đổi phải gắn một finding; thay đổi không có ID thuộc version mới.")
    bad = [i for i in ids if not FIX_ID_RE.match(i)]
    if bad:
        fail(f"ID không hợp lệ: {', '.join(bad)} (dạng C-03 / B-07).")
    unknown = [i for i in ids if i not in known]
    if unknown:
        print(f"[CẢNH BÁO] ID không thấy trong báo cáo mới nhất: {', '.join(unknown)}", file=sys.stderr)

    tag = snapshot_rev(proj, feat, ver, cur)
    entry.setdefault("sealed", False)
    entry["rev"] = nxt
    rec = {"rev": nxt, "at": now_iso(), "scope": args.scope, "fixes": ids}
    if args.note:
        rec["note"] = args.note
    if args.confirm_extra:
        rec["extra"] = args.confirm_extra
    if args.agent:
        rec["fixer"] = args.agent.strip()
    entry.setdefault("revisions", []).append(rec)
    save_feature_meta(proj, feat, meta)
    block = (f"## rev{nxt} — {today_str()}\n- Sửa theo finding: {', '.join(ids)}\n- Phạm vi: {args.scope} "
             f"(review lại: {', '.join('Tầng ' + ('1' if t == 'core' else '2') for t in SCOPE_TIERS[args.scope])})\n"
             f"- Snapshot trước khi sửa: git tag `{tag}`\n"
             + (f"- Ghi chú: {args.note}\n" if args.note else "")
             + (f"- Vượt rev{AUTO_REV_MAX}: người đã xác nhận — {args.confirm_extra}\n" if args.confirm_extra else ""))
    p = append_revisions(ver_dir, proj, feat, ver, block)
    fix_packet = rdir / "fix-packet.md"
    fix_packet.write_text(build_fix_packet(proj, feat, ver, cur, nxt, ids, args.scope, rdir, ver_dir, args.note or ""), encoding="utf-8")
    build_manifest()
    print(f"[OK] {proj}/{feat}/{ver}: rev{cur} → rev{nxt} (snapshot {tag}); sẽ sửa theo: {', '.join(ids)}")
    print(f"     Nhật ký: {p}")
    print(f"     Fix packet (đầu vào cho agent sửa — agent nào cũng đọc được): {fix_packet}")
    print("\n--- Prompt dán vào phiên MỚI của agent sửa (Antigravity / Cursor / Claude…) ---")
    print(fix_prompt(proj, feat, ver, nxt, fix_packet))
    print("--- hết prompt ---")
    print("→ Sau khi agent sửa xong nó chạy `proto fixed` rồi DỪNG. Review lại chỉ khi người ra lệnh "
          f"(proto next {proj} {feat} {ver} cho biết bước kế).")


# ── Guide demo (TÙY CHỌN, không thuộc cổng review/seal/promote) — xem skill/guide-demo/SKILL.md ──────────────
# Lớp additive nằm NGOÀI thư mục version: prototypes/<p>/<f>/guide/<v>/ (sidecar nhúng version trong iframe).
# Version (kể cả đã khóa) không bị sửa file nào; guide đóng dấu "dựng trên version nào" bằng băm nội dung giao diện.
GUIDE_KIT_DIR = TEMPLATES_DIR / "guide-kit"
GUIDE_HASH_SUFFIX = {".html", ".css", ".js", ".json", ".svg", ".png", ".jpg", ".jpeg", ".webp", ".gif", ".woff", ".woff2"}
GUIDE_ACTIONS = {"reset": [], "say": ["say"], "click": ["target"], "type": ["target", "value"], "select": ["target", "value"],
                 "expectVisible": ["target"], "expectHidden": ["target"], "expectText": ["target", "contains"], "wait": ["ms"]}


def guide_dir_for(proj: str, feat: str, ver: str) -> Path:
    return PROTOTYPES_DIR / proj / feat / "guide" / ver


def version_ui_hash(ver_dir: Path) -> str:
    """Băm phần giao diện của version (html/css/js/json/ảnh/font); bỏ *.md (REVISIONS.md…) để ghi chú không làm guide 'lỗi thời'."""
    h = hashlib.sha256()
    for f in sorted(x for x in ver_dir.rglob("*") if x.is_file() and x.suffix.lower() in GUIDE_HASH_SUFFIX):
        h.update(str(f.relative_to(ver_dir)).encode("utf-8") + b"\0" + f.read_bytes() + b"\0")
    return h.hexdigest()[:16]


def read_guide_json(gdir: Path) -> dict:
    gp = gdir / "guide.json"
    if not gp.is_file():
        fail(f"Chưa có guide ở {gdir.relative_to(ROOT_DIR)} — chạy `proto guide init <project> <feature> <version>`")
    return json.loads(gp.read_text(encoding="utf-8"))


def write_stamp(gdir: Path, gj: dict, proj: str, feat: str, ver: str, ver_dir: Path) -> dict:
    entry = version_entry(feature_meta(proj, feat), ver) or {}
    gj["stamp"] = {"project": proj, "feature": feat, "version": ver, "rev": version_rev(entry),
                   "sealed": bool(entry.get("sealed")), "date": today_str(), "baseHash": version_ui_hash(ver_dir)}
    (gdir / "guide.json").write_text(json.dumps(gj, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return gj["stamp"]


def guide_stale_note(gdir: Path, ver_dir: Path) -> str:
    """'' nếu guide khớp version; ngược lại mô tả ngắn lý do. Không bao giờ chặn."""
    try:
        st = json.loads((gdir / "guide.json").read_text(encoding="utf-8")).get("stamp", {})
    except Exception:
        return "guide.json không đọc được"
    if not st.get("baseHash"):
        return "guide chưa đóng dấu (chạy `proto guide stamp`)"
    return "" if st["baseHash"] == version_ui_hash(ver_dir) else \
        f"giao diện version đã đổi kể từ khi dựng guide ({st.get('date', '?')}, rev{st.get('rev', '?')}) — chạy lại các kịch bản rồi `proto guide stamp`"


def carry_guide(proj: str, feat: str, ver: str, ver_dir: Path, dest_feat_dir: Path) -> None:
    """Promote: nếu version có guide thì chép cùng (không chặn, không bắt buộc); đổi đường dẫn mockup thành ../index.html."""
    gdir = guide_dir_for(proj, feat, ver)
    if not (gdir / "index.html").is_file():
        return
    shutil.copytree(gdir, dest_feat_dir / "guide")
    gp = dest_feat_dir / "guide" / "guide.json"
    gj = json.loads(gp.read_text(encoding="utf-8"))
    gj["app"] = "../index.html"
    gp.write_text(json.dumps(gj, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(f"[INFO] Đã chép kèm guide demo → {dest_feat_dir / 'guide'} (mở qua http: <thư-mục>/guide/index.html)")
    note = guide_stale_note(gdir, ver_dir)
    if note:
        print(f"[CẢNH BÁO] Guide có thể lỗi thời: {note}. Không chặn chốt; soát lại khi cần dùng guide.", file=sys.stderr)


def cmd_guide(args: argparse.Namespace) -> None:
    proj, feat, ver = args.project.strip(), args.feature.strip(), args.version.strip()
    ver_dir = PROTOTYPES_DIR / proj / feat / ver
    if not (ver_dir / "index.html").is_file():
        fail(f"Không thấy version {proj}/{feat}/{ver}")
    gdir = guide_dir_for(proj, feat, ver)
    base_url = get_pages_base_url()
    url = f"{base_url}/prototypes/{proj}/{feat}/guide/{ver}/index.html" if base_url else ""

    if args.action == "init":
        if gdir.exists():
            fail(f"Guide đã tồn tại: {gdir.relative_to(ROOT_DIR)} (không ghi đè). Sửa tại chỗ hoặc xoá thư mục rồi init lại.")
        if not GUIDE_KIT_DIR.is_dir():
            fail(f"Thiếu {GUIDE_KIT_DIR}")
        shutil.copytree(GUIDE_KIT_DIR, gdir)
        title = args.title or f"Hướng dẫn: {feature_meta(proj, feat).get('title', feat)}"
        gj = json.loads((gdir / "guide.json").read_text(encoding="utf-8"))
        gj["title"], gj["app"] = title, f"../../{ver}/index.html"
        st = write_stamp(gdir, gj, proj, feat, ver, ver_dir)
        print(f"[OK] Đã tạo guide: {gdir.relative_to(ROOT_DIR)}  (dựng trên {ver} rev{st['rev']}{' · đã khóa' if st['sealed'] else ' · NHÁP'})")
        print("  Việc kế: khai targets.json + viết scenarios/*.json (từ luồng chính của test case) + scenarios/index.json + voice.json;")
        print("  chạy thử qua http (vd `python3 -m http.server` ở gốc kho) rồi `proto guide check`. Chi tiết: skill/guide-demo/SKILL.md")
        if url:
            print(f"  URL sau khi publish: {url}")
        return

    if args.action == "stamp":
        gj = read_guide_json(gdir)
        st = write_stamp(gdir, gj, proj, feat, ver, ver_dir)
        print(f"[OK] Đã đóng dấu guide: {ver} rev{st['rev']} · băm {st['baseHash']} · {st['date']}")
        return

    # check — chỉ đọc, KHÔNG chặn (trừ --strict)
    gj = read_guide_json(gdir)
    problems: list[str] = []
    note = guide_stale_note(gdir, ver_dir)
    if note:
        problems.append("LỖI THỜI: " + note)
    entry = version_entry(feature_meta(proj, feat), ver) or {}
    st = gj.get("stamp", {})
    if st.get("rev") and version_rev(entry) != st["rev"]:
        problems.append(f"version đang ở rev{version_rev(entry)}, guide dựng trên rev{st['rev']}")

    def load(rel: str, default):
        fp = gdir / rel
        if not fp.is_file():
            return default
        try:
            return json.loads(fp.read_text(encoding="utf-8"))
        except Exception as e:
            problems.append(f"{rel}: JSON hỏng ({e})")
            return default

    targets = load(gj.get("targets", "targets.json"), {})
    intents = load(gj.get("intents", "intents.json"), {})
    src = "\n".join(f.read_text(encoding="utf-8", errors="ignore") for f in ver_dir.rglob("*")
                    if f.is_file() and f.suffix in {".html", ".js"} and f.stat().st_size < 3_000_000)

    unchecked = 0
    names_used: set[str] = set()
    index = load(gj.get("scenarios", "scenarios/index.json"), [])
    if not index:
        problems.append("scenarios/index.json trống — guide chưa có kịch bản")
    for fn in index:
        sc = load("scenarios/" + fn, None)
        if not isinstance(sc, dict) or not isinstance(sc.get("steps"), list):
            problems.append(f"scenarios/{fn}: thiếu mảng steps")
            continue
        for k in ("id", "title"):
            if not sc.get(k):
                problems.append(f"scenarios/{fn}: thiếu \"{k}\"")
        todo = list(sc["steps"])
        while todo:
            stp = todo.pop()
            if "use" in stp:
                it = intents.get(stp["use"])
                if it is None:
                    problems.append(f"scenarios/{fn}: intent không tồn tại \"{stp['use']}\"")
                else:
                    todo.extend(it.get("steps", []))
                continue
            need = GUIDE_ACTIONS.get(stp.get("do"))
            if need is None:
                problems.append(f"scenarios/{fn}: hành động không hợp lệ \"{stp.get('do')}\"")
                continue
            for fld in need:
                if fld not in stp:
                    problems.append(f"scenarios/{fn}: bước {stp.get('do')} thiếu \"{fld}\"")
            if stp.get("target") and "${" not in stp["target"]:
                names_used.add(stp["target"])
    for name in sorted(names_used):
        css = targets.get(name)
        if css is None:
            css = f'[data-testid="{name}"]'
        m = re.fullmatch(r"#([\w-]+)", css) or re.fullmatch(r'\[data-testid="([^"]+)"\]', css)
        if not m:
            unchecked += 1
        elif m.group(1) not in src:
            problems.append(f"phần tử \"{name}\" → {css}: không còn thấy \"{m.group(1)}\" trong mã của version")

    print(f"Guide {proj}/{feat}/{ver}: dấu {st.get('version', '?')} rev{st.get('rev', '?')} · {st.get('date', '?')} · {len(index)} kịch bản · {len(names_used)} phần tử trỏ tới"
          + (f" ({unchecked} selector phức tạp chưa kiểm tĩnh được)" if unchecked else ""))
    if problems:
        for pr in problems:
            print(f"  [!] {pr}")
        print("  (Chỉ là gợi ý — guide là tài liệu tham khảo, không chặn tiến độ. Chạy thử trên trình duyệt để chắc.)")
        if args.strict:
            sys.exit(1)
    else:
        print("  [OK] Guide khớp version và mọi phần tử kịch bản còn trong mã.")
    if url:
        print(f"  URL: {url}")


def cmd_seal(args: argparse.Namespace) -> None:
    """Cổng của NGƯỜI: version chuyển từ nháp sang bất biến (từ đây chỉ tạo version mới)."""
    proj, feat, ver = args.project.strip(), args.feature.strip(), args.version.strip()
    if not (PROTOTYPES_DIR / proj / feat / ver / "index.html").is_file():
        fail(f"Không thấy phiên bản {proj}/{feat}/{ver} trong kho mockup.")
    meta = feature_meta(proj, feat)
    entry = version_entry(meta, ver)
    if entry is None:
        fail(f"{ver} chưa có trong meta.json của {feat}.")
    if entry.get("sealed"):
        fail(f"{ver} đã khóa lúc {entry.get('sealed_at', '?')}.")
    if not args.by.strip():
        fail("Cần --by <tên người cho qua> — máy không tự khóa.")
    pd = project_dir_for(proj, args.project_path, required=False)
    st = review_state(proj, pd, feat, ver)

    hard = []
    if not st["core"]:
        hard.append("chưa có báo cáo Tầng 1")
    if st["needs_business"] and not st["business"]:
        hard.append("chưa có báo cáo Tầng 2 dù dự án có BUSINESS-REVIEW.md")
    if st["stale"]:
        hard.append(f"bản đã đổi sau lần review cuối — review lại tầng: {', '.join(st['stale'])}")
    if hard:
        fail(f"Chưa qua cổng máy: {'; '.join(hard)}. (Thiếu/lỗi thời review không thể cho qua bằng --accept.)")

    open_ids = {i["id"]: i for i in st["open"] if i["id"]}
    noid = [i for i in st["open"] if not i["id"]]
    accept, assume = parse_ids(args.accept), parse_ids(args.assume)
    both = set(accept) & set(assume)
    if both:
        fail(f"ID vừa --accept vừa --assume: {', '.join(sorted(both))}")
    unknown = [i for i in accept + assume if i not in open_ids]
    if unknown:
        fail(f"Không phải BLOCKER/MAJOR đang mở: {', '.join(unknown)}. Đang mở: {', '.join(open_ids) or '(không)'}")
    if accept or assume:
        if not (args.reason or "").strip():
            fail("Cho qua BLOCKER/MAJOR phải nói lý do: --reason \"…\" (ghi vào meta + REVISIONS.md, có thể công khai — không ghi dữ liệu nhạy cảm).")
    left = [i for i in open_ids if i not in accept and i not in assume]
    if left or noid:
        extra = f"; {len(noid)} finding thiếu ID (không cho qua được — yêu cầu reviewer gắn ID)" if noid else ""
        fail("Còn BLOCKER/MAJOR chưa xử lý: " + ", ".join(f"{i}({open_ids[i]['sev']})" for i in left) + extra +
             "\n  → Sửa (proto revise) hoặc cho qua có chủ đích: --accept ID,… (chấp nhận) / --assume ID,… (giả định chờ chuyên gia) kèm --reason.")
    blockers = [i for i in accept + assume if open_ids[i]["sev"] == "BLOCKER"]
    if blockers:
        print(f"[CẢNH BÁO] Bạn đang cho qua BLOCKER: {', '.join(blockers)} — được ghi tên + lý do vào nhật ký.", file=sys.stderr)

    rev = version_rev(entry)
    tag = snapshot_rev(proj, feat, ver, rev)
    now = now_iso()
    entry["rev"], entry["sealed"], entry["sealed_at"], entry["sealed_by"] = rev, True, now, args.by.strip()
    for kind, group in (("accepted", accept), ("assumed", assume)):
        for i in group:
            entry.setdefault("accepted", []).append({"id": i, "sev": open_ids[i]["sev"], "kind": kind,
                                                     "reason": args.reason.strip(), "at": now})
    save_feature_meta(proj, feat, meta)
    lines = [f"## 🔒 Khóa rev{rev} — {today_str()} — bởi {args.by.strip()}", f"- Snapshot: git tag `{tag}`"]
    if accept:
        lines.append(f"- Chấp nhận có chủ đích: {', '.join(accept)}")
    if assume:
        lines.append(f"- Giả định chờ chuyên gia xác nhận: {', '.join(assume)}")
    if accept or assume:
        lines.append(f"- Lý do: {args.reason.strip()}")
    append_revisions(PROTOTYPES_DIR / proj / feat / ver, proj, feat, ver, "\n".join(lines) + "\n")
    build_manifest()
    print(f"[OK] Đã KHÓA {proj}/{feat}/{ver} ở rev{rev} (bởi {args.by.strip()}). Gửi link cho người trong dự án.")
    print(f"→ Từ đây không sửa tại chỗ: phản hồi không hợp → `proto brief {proj} {feat} {ver} --human …` rồi `proto new` version mới.")
    print("→ Chạy `proto publish` khi cần cập nhật nhãn trạng thái trên Hub (lệnh đó commit + push).")


def main() -> None:
